// Things that float above the window: the context menu, prompts and toasts.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Jam, Devices, Device, Settings, Menu, Prompt, Toast, MenuEntry } from "types.slint";
import { Icon, IconButton, TextButton, LinkText, Field, Toggle } from "widgets.slint";

component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    // The keyboard is on this entry.
    in property <bool> focused;
    callback activated;

    height: 38px;
    border-radius: 4px;
    background: touch.has-hover || self.focused ? Theme.press : transparent;

    accessible-role: button;
    accessible-label: self.entry.label;
    accessible-action-default => { root.activated(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.entry.icon;
                size: 16px;
                tint: root.entry.danger ? Theme.danger : touch.has-hover || root.focused ? Theme.text : Theme.muted;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.entry.label;
            color: root.entry.danger ? Theme.danger : Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.entry.submenu: VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.chevron-right;
                size: 16px;
            }
        }
    }
}

export component MenuOverlay inherits Rectangle {
    property <int> separators: 0;
    property <length> panel-height: min(panel-content.preferred-height, self.height - 16px);
    // A new set of entries starts with the keyboard on none of them, at the top.
    property <[MenuEntry]> shown: Menu.entries;
    changed shown => {
        Menu.cursor = -1;
        flick.content-y = 0;
    }
    // Keep the entry the keyboard is on in view when the menu is taller than the window.
    property <length> cursor-y: Menu.cursor-y;
    changed cursor-y => {
        if -flick.content-y > self.cursor-y - 4px {
            flick.content-y = -(self.cursor-y - 4px);
        } else if -flick.content-y + flick.height < self.cursor-y + 42px {
            flick.content-y = flick.height - self.cursor-y - 42px;
        }
    }

    // Anything outside the menu closes it.
    TouchArea {
        clicked => { Menu.dismissed(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button != PointerEventButton.left {
                Menu.dismissed();
            }
        }
        scroll-event => {
            Menu.dismissed();
            return accept;
        }
    }

    Rectangle {
        x: clamp(Menu.x, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(Menu.y, 8px, max(8px, root.height - self.height - 8px));
        // As wide as its longest entry needs, within reason.
        width: clamp(panel-content.preferred-width, 168px, 320px);
        height: root.panel-height;
        border-radius: 8px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000a0;
        clip: true;

        // Swallow clicks on the menu's own padding, and the wheel: turning it over a menu
        // scrolls the menu if it's long and otherwise does nothing.
        TouchArea {
            scroll-event => { return accept; }
        }

        // A menu with more entries than fit (a long list of playlists) scrolls.
        flick := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: panel-content.preferred-height;

        panel-content := VerticalLayout {
            width: flick.width;
            padding: 4px;
            alignment: start;

            if Menu.title != "": Text {
                height: 34px;
                text: "   " + Menu.title;
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            for entry[index] in Menu.entries: VerticalLayout {
                if entry.separator: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                }

                if !entry.separator: MenuRow {
                    entry: entry;
                    focused: index == Menu.cursor;
                    activated => { Menu.activated(entry.id); }
                }
            }
        }
        }
    }
}

export component PromptOverlay inherits Rectangle {
    background: #000000a6;
    callback focus-input();
    focus-input => { input.focus(); }

    // Block clicks from reaching the window behind. Clicking outside the box closes it
    // without choosing either answer.
    TouchArea {
        clicked => { Prompt.dismissed(); }
    }

    Rectangle {
        width: min(440px, root.width - 48px);
        height: content.preferred-height;
        border-radius: 12px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000a0;

        TouchArea { }

        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Prompt.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            if Prompt.message != "": Text {
                text: Prompt.message;
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            input := Field {
                visible: Prompt.wants-text;
                height: Prompt.wants-text ? 44px : 0px;
                text <=> Prompt.text;
                label: Prompt.title;
                accepted => {
                    if Prompt.text != "" {
                        Prompt.confirmed(Prompt.text);
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                // Something that's only there to be read has one button, to close it.
                if Prompt.cancel-label != "": TextButton {
                    text: Prompt.cancel-label;
                    clicked => { Prompt.cancelled(); }
                }

                TextButton {
                    text: Prompt.confirm-label;
                    primary: !Prompt.danger;
                    danger: Prompt.danger;
                    enabled: !Prompt.wants-text || Prompt.text != "";
                    clicked => { Prompt.confirmed(Prompt.text); }
                }
            }
        }
    }
}

// A small heading over a field or a group of things.
component JamLabel inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
}

// The window for jams: joining one, starting one, and looking after one hosted here.
export component JamOverlay inherits Rectangle {
    // What's typed in the boxes, and whether the link has just been copied.
    property <string> typed-name: Jam.name;
    property <string> typed-link;
    property <bool> copied;
    function join() {
        if self.typed-link != "" && !Jam.busy {
            Jam.join(self.typed-link, self.typed-name);
        }
    }

    background: #000000a6;

    TouchArea {
        clicked => { Jam.open = false; }
    }

    Rectangle {
        width: min(500px, root.width - 48px);
        height: content.preferred-height;
        border-radius: 12px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000a0;

        TouchArea { }

        // Escape closes it, wherever in it the keyboard is.
        scope := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Jam.open = false;
                    return accept;
                }
                return reject;
            }

            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: Jam.hosting ? "Your jam" : "Jam";
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.x;
                            label: "Close";
                            clicked => { Jam.open = false; }
                        }
                    }
                }

                // ---- no jam yet: join one, or start one ----
                if !Jam.hosting: VerticalLayout {
                    spacing: 16px;

                    Text {
                        text: "One queue that everyone adds to. The music plays where the host is; everyone else picks songs.";
                        color: Theme.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        JamLabel {
                            text: "Your name";
                        }

                        Field {
                            text <=> root.typed-name;
                            placeholder: "What the others will see";
                            label: "Your name";
                            accepted => { root.join(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        JamLabel {
                            text: "Join a jam";
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Field {
                                text <=> root.typed-link;
                                placeholder: "Paste the link its host sent you";
                                label: "Jam link";
                                horizontal-stretch: 1;
                                init => { self.focus(); }
                                accepted => { root.join(); }
                            }

                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    text: "Join";
                                    primary: true;
                                    enabled: root.typed-link != "" && !Jam.busy;
                                    clicked => { root.join(); }
                                }
                            }
                        }
                    }

                    if Jam.problem != "": Text {
                        text: Jam.problem;
                        color: Theme.danger;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }

                    if Jam.can-host: HorizontalLayout {
                        spacing: 16px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;

                            JamLabel {
                                text: "Host a jam";
                            }

                            Text {
                                text: "The music plays on this PC. Friends join with a link and add to your queue.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                text: Jam.busy ? "Starting…" : "Start a jam";
                                enabled: !Jam.busy;
                                clicked => { Jam.start(root.typed-name); }
                            }
                        }
                    }

                    if !Jam.can-host: HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: "To host a jam yourself, switch hosting on in Settings.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            LinkText {
                                text: "Open Settings";
                                ink: Theme.accent-bright;
                                clicked => {
                                    Jam.open = false;
                                    Settings.tab = 5;
                                    App.navigate("settings");
                                }
                            }
                        }
                    }
                }

                // ---- a jam hosted here ----
                if Jam.hosting: VerticalLayout {
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 16px;

                        // For a phone's camera. White whatever the theme, so it scans.
                        Rectangle {
                            width: 132px;
                            height: 132px;
                            border-radius: 8px;
                            background: white;
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: Jam.qr;
                                image-rendering: pixelated;
                                accessible-role: none;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            horizontal-stretch: 1;
                            // The link is as long as it is; the window isn't made wider for it.
                            min-width: 0px;
                            preferred-width: 0px;

                            Text {
                                text: "Friends open this link to join, in a browser or in Nexus Music under Jam.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: Theme.raised;
                                border-width: 1px;
                                border-color: Theme.line;
                                clip: true;

                                shown-link := TextInput {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    text: Jam.link;
                                    read-only: true;
                                    single-line: true;
                                    color: Theme.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: white;
                                    accessible-label: "Jam link";
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                TextButton {
                                    text: root.copied ? "Copied" : "Copy link";
                                    primary: true;
                                    clicked => {
                                        shown-link.select-all();
                                        shown-link.copy();
                                        root.copied = true;
                                    }
                                }
                            }
                        }
                    }

                    if Jam.status != "": Text {
                        text: Jam.status;
                        color: Theme.warm;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        spacing: 6px;

                        JamLabel {
                            text: Jam.guests.length == 0 ? "Nobody has joined yet" : Jam.guests.length == 1 ? "1 guest" : Jam.guests.length + " guests";
                        }

                        if Jam.guests.length > 0: Flickable {
                            height: min(guest-rows.preferred-height, 132px);
                            content-height: guest-rows.preferred-height;

                            guest-rows := VerticalLayout {
                                for guest in Jam.guests: HorizontalLayout {
                                    height: 32px;
                                    spacing: 12px;

                                    Text {
                                        text: guest.name;
                                        color: Theme.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        LinkText {
                                            text: "Remove";
                                            clicked => { Jam.remove-guest(guest.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;

                            JamLabel {
                                text: "Guests can steer";
                            }

                            Text {
                                text: "They can pause, skip, reorder the queue and take songs out. Off, they can still add songs and take out the ones they added.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: Jam.guests-control;
                                label: "Guests can steer";
                                toggled(on) => { Jam.set-guests-control(on); }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        TextButton {
                            text: "End jam";
                            danger: true;
                            clicked => {
                                Jam.end();
                                Jam.open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}

// One device in the list.
component DeviceRow inherits Rectangle {
    in property <Device> device;
    callback chosen;

    height: 56px;
    border-radius: 8px;
    background: touch.has-hover && self.device.ready ? Theme.hover : transparent;
    opacity: self.device.ready ? 1 : 0.5;

    accessible-role: button;
    accessible-label: self.device.name + ", " + self.device.about;
    accessible-action-default => {
        if self.device.ready {
            root.chosen();
        }
    }

    touch := TouchArea {
        enabled: root.device.ready;
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.monitor-speaker;
                size: 20px;
                tint: root.device.active ? Theme.accent-bright : Theme.muted;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;

            Text {
                text: root.device.name;
                color: root.device.active ? Theme.accent-bright : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                text: root.device.about;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                accessible-role: none;
            }
        }
    }
}

// The list of the person's devices, over the bottom right corner where its button is.
export component DevicesOverlay inherits Rectangle {
    // How far above the bottom of the window the list sits: clear of the player bar.
    in property <length> lift: 96px;

    // Anything outside the list closes it.
    TouchArea {
        clicked => { Devices.open = false; }
    }

    Rectangle {
        x: root.width - self.width - 16px;
        y: root.height - self.height - root.lift;
        width: min(340px, root.width - 32px);
        height: min(content.preferred-height, root.height - root.lift - 16px);
        border-radius: 12px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #000000a0;
        clip: true;

        TouchArea { }

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Devices.open = false;
                    return accept;
                }
                return reject;
            }

            content := VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    height: 32px;
                    text: "  Play on";
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                for device in Devices.list: DeviceRow {
                    device: device;
                    chosen => { Devices.choose(device.id); }
                }

                if Devices.list.length < 2: Text {
                    text: "  Your other devices show up here when Nexus Music is open on them, signed in to the same account, with the same relay set up under Settings, Jam.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component ToastOverlay inherits Rectangle {
    // Room for the action ("Undo") beside the words, when there is one.
    property <length> action-width: Toast.action == "" ? 0px : action.preferred-width + 28px;
    height: 44px;
    width: min(label.preferred-width + 40px + self.action-width, 560px);
    border-radius: 22px;
    background: Theme.text;
    opacity: Toast.visible ? 1 : 0;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000090;
    animate opacity { duration: 180ms; }
    accessible-role: none;

    label := Text {
        x: 20px;
        width: parent.width - 40px - root.action-width;
        text: Toast.text;
        color: Theme.base;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - root.action-width - 8px;
        y: 6px;
        width: root.action-width;
        height: parent.height - 12px;
        border-radius: 16px;
        visible: Toast.action != "";
        background: act.has-hover ? Theme.base.transparentize(0.82) : Theme.base.transparentize(0.9);
        accessible-role: button;
        accessible-label: Toast.action;
        accessible-action-default => { Toast.acted(); }

        action := Text {
            text: Toast.action;
            color: Theme.base;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        act := TouchArea {
            enabled: Toast.visible && Toast.action != "";
            mouse-cursor: pointer;
            clicked => { Toast.acted(); }
        }
    }
}
