// Things that float above the window: the context menu, prompts and toasts.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Menu, Prompt, Toast, MenuEntry } from "types.slint";
import { Icon, TextButton, Field } from "widgets.slint";

component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    // The keyboard is on this entry.
    in property <bool> focused;
    callback activated;

    height: 38px;
    border-radius: 4px;
    background: touch.has-hover || self.focused ? Theme.press : transparent;

    accessible-role: button;
    accessible-label: self.entry.label;
    accessible-action-default => { root.activated(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.entry.icon;
                size: 16px;
                tint: root.entry.danger ? Theme.danger : touch.has-hover || root.focused ? Theme.text : Theme.muted;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.entry.label;
            color: root.entry.danger ? Theme.danger : Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.entry.submenu: VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.chevron-right;
                size: 16px;
            }
        }
    }
}

export component MenuOverlay inherits Rectangle {
    property <int> separators: 0;
    property <length> panel-height: min(panel-content.preferred-height, self.height - 16px);
    // A new set of entries starts with the keyboard on none of them, at the top.
    property <[MenuEntry]> shown: Menu.entries;
    changed shown => {
        Menu.cursor = -1;
        flick.content-y = 0;
    }
    // Keep the entry the keyboard is on in view when the menu is taller than the window.
    property <length> cursor-y: Menu.cursor-y;
    changed cursor-y => {
        if -flick.content-y > self.cursor-y - 4px {
            flick.content-y = -(self.cursor-y - 4px);
        } else if -flick.content-y + flick.height < self.cursor-y + 42px {
            flick.content-y = flick.height - self.cursor-y - 42px;
        }
    }

    // Anything outside the menu closes it.
    TouchArea {
        clicked => { Menu.dismissed(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button != PointerEventButton.left {
                Menu.dismissed();
            }
        }
        scroll-event => {
            Menu.dismissed();
            return accept;
        }
    }

    Rectangle {
        x: clamp(Menu.x, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(Menu.y, 8px, max(8px, root.height - self.height - 8px));
        // As wide as its longest entry needs, within reason.
        width: clamp(panel-content.preferred-width, 168px, 320px);
        height: root.panel-height;
        border-radius: 8px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000a0;
        clip: true;

        // Swallow clicks on the menu's own padding, and the wheel: turning it over a menu
        // scrolls the menu if it's long and otherwise does nothing.
        TouchArea {
            scroll-event => { return accept; }
        }

        // A menu with more entries than fit (a long list of playlists) scrolls.
        flick := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: panel-content.preferred-height;

        panel-content := VerticalLayout {
            width: flick.width;
            padding: 4px;
            alignment: start;

            if Menu.title != "": Text {
                height: 34px;
                text: "   " + Menu.title;
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            for entry[index] in Menu.entries: VerticalLayout {
                if entry.separator: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                }

                if !entry.separator: MenuRow {
                    entry: entry;
                    focused: index == Menu.cursor;
                    activated => { Menu.activated(entry.id); }
                }
            }
        }
        }
    }
}

export component PromptOverlay inherits Rectangle {
    background: #000000a6;
    callback focus-input();
    focus-input => { input.focus(); }

    // Block clicks from reaching the window behind. Clicking outside the box closes it
    // without choosing either answer.
    TouchArea {
        clicked => { Prompt.dismissed(); }
    }

    Rectangle {
        width: min(440px, root.width - 48px);
        height: content.preferred-height;
        border-radius: 12px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000a0;

        TouchArea { }

        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Prompt.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            if Prompt.message != "": Text {
                text: Prompt.message;
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            input := Field {
                visible: Prompt.wants-text;
                height: Prompt.wants-text ? 44px : 0px;
                text <=> Prompt.text;
                label: Prompt.title;
                accepted => {
                    if Prompt.text != "" {
                        Prompt.confirmed(Prompt.text);
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                // Something that's only there to be read has one button, to close it.
                if Prompt.cancel-label != "": TextButton {
                    text: Prompt.cancel-label;
                    clicked => { Prompt.cancelled(); }
                }

                TextButton {
                    text: Prompt.confirm-label;
                    primary: !Prompt.danger;
                    danger: Prompt.danger;
                    enabled: !Prompt.wants-text || Prompt.text != "";
                    clicked => { Prompt.confirmed(Prompt.text); }
                }
            }
        }
    }
}

export component ToastOverlay inherits Rectangle {
    // Room for the action ("Undo") beside the words, when there is one.
    property <length> action-width: Toast.action == "" ? 0px : action.preferred-width + 28px;
    height: 44px;
    width: min(label.preferred-width + 40px + self.action-width, 560px);
    border-radius: 22px;
    background: Theme.text;
    opacity: Toast.visible ? 1 : 0;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000090;
    animate opacity { duration: 180ms; }
    accessible-role: none;

    label := Text {
        x: 20px;
        width: parent.width - 40px - root.action-width;
        text: Toast.text;
        color: Theme.base;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - root.action-width - 8px;
        y: 6px;
        width: root.action-width;
        height: parent.height - 12px;
        border-radius: 16px;
        visible: Toast.action != "";
        background: act.has-hover ? Theme.base.transparentize(0.82) : Theme.base.transparentize(0.9);
        accessible-role: button;
        accessible-label: Toast.action;
        accessible-action-default => { Toast.acted(); }

        action := Text {
            text: Toast.action;
            color: Theme.base;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        act := TouchArea {
            enabled: Toast.visible && Toast.action != "";
            mouse-cursor: pointer;
            clicked => { Toast.acted(); }
        }
    }
}
