// Small building blocks shared by every screen.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Covers, Card, CardKind, Track, Player, View, Drag } from "types.slint";

export component Icon inherits Image {
    in property <length> size: 18px;
    in property <brush> tint: Theme.muted;
    width: self.size;
    height: self.size;
    colorize: self.tint;
    accessible-role: none;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 18px;
    in property <brush> tint: Theme.muted;
    in property <brush> hover-tint: Theme.text;
    // Toggled on, e.g. shuffle enabled.
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> label;
    out property <bool> has-hover: touch.has-hover;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    opacity: self.enabled ? 1 : 0.35;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Icon {
        source: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.accent-bright : touch.has-hover ? root.hover-tint : root.tint;
    }

    if root.label != "": Tooltip {
        Rectangle {
            background: Theme.overlay;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text {
                    text: root.label;
                    color: Theme.text;
                    font-size: 12px;
                }
            }
        }
    }
}

// The round violet button that starts playback.
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 52px;
    in property <string> label: self.playing ? "Pause" : "Play";
    // Shows a plus instead: the button adds something, it doesn't play it.
    in property <bool> adds;
    callback clicked;

    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: touch.pressed ? Theme.accent : touch.has-hover ? Theme.accent-bright.brighter(0.12) : Theme.accent-bright;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Icon {
        source: root.adds ? Icons.plus : root.playing ? Icons.pause-fill : Icons.play-fill;
        size: root.adds ? root.size * 0.5 : root.size * 0.42;
        tint: Theme.on-accent;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;

    height: 40px;
    min-width: label.preferred-width + 40px;
    border-radius: self.height / 2;
    border-width: self.primary || self.danger ? 0px : 1px;
    border-color: touch.has-hover ? Theme.text : Theme.faint;
    background: self.danger ? (touch.has-hover ? Theme.danger.brighter(0.1) : Theme.danger)
        : self.primary ? (touch.has-hover ? Theme.accent-bright.brighter(0.12) : Theme.accent-bright)
        : transparent;
    opacity: self.enabled ? 1 : 0.5;
    animate background, border-color { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        width: min(self.preferred-width, root.width - 32px);
        text: root.text;
        color: root.primary || root.danger ? Theme.on-accent : Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
}

// Text that behaves like a link: underlined on hover.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <brush> ink: Theme.muted;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    in property <bool> enabled: true;
    callback clicked;

    height: label.preferred-height;
    preferred-width: label.preferred-width;
    min-width: 0px;
    horizontal-stretch: 0;

    // A link: a screen reader can name it and follow it.
    accessible-role: button;
    accessible-label: self.text;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if self.enabled {
            self.clicked();
        }
    }

    label := Text {
        x: 0;
        width: min(parent.width, self.preferred-width);
        text: root.text;
        accessible-role: none;
        color: touch.has-hover && root.enabled ? Theme.text : root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        overflow: elide;
    }

    if touch.has-hover && root.enabled: Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: label.width;
        height: 1px;
        background: Theme.text;
    }

    touch := TouchArea {
        width: label.width;
        x: 0;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The scrollbar for every list and page: a slim thumb in a lane of its own at the right edge.
// Used in place of the stock one so it matches the theme and rows can stop just short of it.
export component ScrollThumb inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> visible-height;

    property <length> maximum: max(0px, self.content-height - self.visible-height);
    property <length> inset: 4px;
    property <length> track: self.height - 2 * self.inset;
    property <length> thumb-height: clamp(self.track * self.visible-height / max(self.content-height, 1px), min(36px, self.track), self.track);
    property <length> travel: max(1px, self.track - self.thumb-height);

    width: 14px;
    visible: self.maximum > 0;

    touch := TouchArea {
        property <length> grab-y;
        property <length> grab-offset;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                // Pressing the lane away from the thumb brings the thumb to the pointer first.
                if self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height {
                    root.content-y = -clamp((self.mouse-y - root.inset - root.thumb-height / 2) / root.travel, 0, 1) * root.maximum;
                }
                self.grab-y = self.mouse-y;
                self.grab-offset = -root.content-y;
            }
        }
        moved => {
            if self.pressed {
                root.content-y = -clamp(self.grab-offset + (self.mouse-y - self.grab-y) * (root.maximum / root.travel), 0px, root.maximum);
            }
        }
        scroll-event(event) => {
            root.content-y = clamp(root.content-y + event.delta-y, -root.maximum, 0px);
            accept
        }
    }

    thumb := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.inset + root.travel * clamp(-root.content-y / max(root.maximum, 1px), 0, 1);
        width: touch.has-hover || touch.pressed ? 6px : 4px;
        height: root.thumb-height;
        border-radius: self.width / 2;
        background: touch.pressed ? Theme.muted : touch.has-hover ? Theme.faint : #ffffff2e;
        animate width, background { duration: 120ms; }
    }
}

// Drag-to-reorder for a row in a list of equal-height rows. The row's TouchArea feeds it the
// pointer; it works out where the row would land, draws the insertion line, and scrolls the
// list when the pointer nears its top or bottom.
export component Reorder inherits Rectangle {
    // The row can be dragged at all.
    in property <bool> enabled;
    // Dragging within the list moves the row to a new place.
    in property <bool> reorder: true;
    // Dragging can also carry the row to a playlist or the queue (see `Drag`).
    in property <bool> droppable;
    in property <string> label;
    in property <int> index;
    in property <int> count;
    // Top and bottom of the list's visible part, in window coordinates.
    in property <length> list-top;
    in property <length> list-bottom;
    out property <bool> dragging;
    // The row the drag began on. (While the list scrolls under a drag, the element doing
    // the dragging can come to show a different row, so `index` can't be relied on.)
    out property <int> origin;
    // How many places that row would move if let go now.
    out property <int> delta: !self.dragging ? 0 : clamp(self.slot, 0, self.count - 1) - self.origin;
    callback moved(origin: int, delta: int);
    callback dropped(origin: int, target: string);
    callback nudge(by: length);

    property <bool> armed;
    property <bool> finishing;
    property <length> press-y;
    // Where the pointer is, in window coordinates, as of its last movement.
    property <length> pointer-y;
    // Where the list's first row is (or would be), in window coordinates.
    property <length> first-row-y: self.absolute-position.y - self.index * self.height;
    property <int> slot: floor((self.pointer-y - self.first-row-y) / self.height);
    property <length> edge: 40px;

    public function press(y: length) {
        self.armed = self.enabled;
        self.press-y = y;
        self.origin = self.index;
    }
    // `x` and `y` are the pointer's position within the row.
    public function drag(x: length, y: length) {
        if self.armed && !self.dragging && (y - self.press-y > 6px || self.press-y - y > 6px) {
            self.dragging = true;
            if self.droppable {
                Drag.label = self.label;
                Drag.target = "";
                Drag.active = true;
            }
        }
        self.pointer-y = self.absolute-position.y + y;
        if self.dragging && self.droppable {
            Drag.x = self.absolute-position.x + x;
            Drag.y = self.pointer-y;
        }
    }
    public function release() {
        if self.dragging && self.droppable {
            // Places that accept a drop notice the pointer a moment after it moves, so give
            // them that moment before deciding where the songs landed.
            self.finishing = true;
        } else {
            self.finish();
        }
    }
    function finish() {
        self.finishing = false;
        if self.dragging && self.droppable && Drag.target != "" {
            root.dropped(self.origin, Drag.target);
        } else if self.dragging && self.reorder && self.delta != 0 {
            root.moved(self.origin, self.delta);
        }
        self.cancel();
    }
    public function cancel() {
        if self.dragging && self.droppable {
            Drag.active = false;
            Drag.target = "";
        }
        self.dragging = false;
        self.armed = false;
    }

    Timer {
        interval: 20ms;
        running: root.finishing;
        triggered => { root.finish(); }
    }

    // The line showing where the row would land.
    if root.dragging && root.reorder && root.delta != 0 && !(root.droppable && Drag.target != ""): Rectangle {
        y: (root.origin + root.delta + (root.delta > 0 ? 1 : 0) - root.index) * root.height - 1px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-bright;
    }

    Timer {
        interval: 16ms;
        running: root.dragging && (root.pointer-y < root.list-top + root.edge || root.pointer-y > root.list-bottom - root.edge);
        triggered => {
            root.nudge(root.pointer-y < root.list-top + root.edge ? 9px : -9px);
        }
    }
}

// Album, artist or playlist artwork. Art arrives asynchronously; a glyph stands in until then.
export component Cover inherits Rectangle {
    in property <string> art;
    in property <bool> round;
    in property <image> placeholder: Icons.music;
    // Edge length used to pick an image resolution; defaults to the rendered width.
    in property <length> detail: self.width;

    border-radius: self.round ? self.width / 2 : clamp(self.width * 0.06, 3px, 8px);
    background: Theme.raised;
    clip: true;

    if picture.source.width == 0: Icon {
        source: root.placeholder;
        size: clamp(root.width * 0.36, 14px, 72px);
        tint: Theme.faint;
    }

    picture := Image {
        width: 100%;
        height: 100%;
        image-fit: cover;
        source: Covers.get(root.art, root.detail / 1px, Covers.rev);
        accessible-role: none;
    }
}

export component Slider inherits Rectangle {
    // 0 to 1.
    in property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    out property <bool> dragging: touch.pressed;
    out property <float> drag-value;
    out property <bool> has-hover: touch.has-hover;
    callback moved(value: float);
    callback released(value: float);
    callback scrolled(delta: float);

    property <float> shown: self.dragging ? self.drag-value : clamp(self.value, 0, 1);
    height: 16px;
    min-width: 40px;

    accessible-role: slider;
    accessible-label: self.label;
    accessible-value: Math.round(self.shown * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-value = clamp(self.mouse-x / self.width, 0, 1);
                root.moved(root.drag-value);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.released(root.drag-value);
            }
        }
        moved => {
            if self.pressed {
                root.drag-value = clamp(self.mouse-x / self.width, 0, 1);
                root.moved(root.drag-value);
            }
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y / 1px);
            return accept;
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff2b;

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: 2px;
            background: touch.has-hover || root.dragging ? Theme.accent-bright : Theme.text;
        }
    }

    if touch.has-hover || root.dragging: Rectangle {
        x: clamp(root.width * root.shown - 6px, 0px, root.width - 12px);
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
    }
}

export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    // The placeholder's colour; stronger when it stands for something already on file.
    in property <brush> placeholder-ink: Theme.faint;
    in property <InputType> input-type: InputType.text;
    in property <string> label;
    callback accepted;
    callback edited;

    height: 44px;
    border-radius: 8px;
    background: Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-bright : Theme.line;
    forward-focus: input;
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        // A field is as wide as its place in the layout, whatever is typed in it: long
        // text scrolls inside the field and never pushes the layout wider.
        Rectangle {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            clip: true;

            if input.text == "": Text {
                x: 0;
                width: parent.width;
                text: root.placeholder;
                color: root.placeholder-ink;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            input := TextInput {
                width: parent.width;
                height: parent.height;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                input-type: root.input-type;
                selection-background-color: Theme.accent;
                selection-foreground-color: white;
                accessible-label: root.label;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
        }
    }
}

// A switch for a setting that takes effect immediately.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled(on: bool);

    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: self.on ? Theme.accent-bright : #ffffff2b;
    animate background { duration: 140ms; }

    accessible-role: switch;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.on;
    accessible-action-default => { root.toggled(!root.on); }

    Rectangle {
        x: root.on ? 19px : 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Theme.on-accent : Theme.text;
        animate x { duration: 140ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// A choice of one from a few, as a single control: the options side by side in one track,
// the chosen one filled in. For settings; `Chip` is for narrowing a list.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    // What's being chosen, for screen readers.
    in property <string> label;
    callback chosen(index: int);

    height: 36px;
    width: track.preferred-width;
    border-radius: 18px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;

    track := HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for name[index] in root.options: Rectangle {
            property <bool> on: index == root.selected;
            width: caption.preferred-width + 26px;
            border-radius: 15px;
            background: self.on ? Theme.text : touch.has-hover ? Theme.press : transparent;
            animate background { duration: 120ms; }

            accessible-role: button;
            accessible-label: root.label != "" ? root.label + ": " + name : name;
            accessible-checkable: true;
            accessible-checked: self.on;
            accessible-action-default => { root.chosen(index); }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(index); }
            }

            caption := Text {
                text: name;
                color: parent.on ? Theme.base : touch.has-hover ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: parent.on ? 600 : 500;
                accessible-role: none;
            }
        }
    }
}

// A choice from a list too long or too changeable to lay out: shows what's chosen, and opens
// the list when clicked.
export component Select inherits Rectangle {
    in property <string> text;
    in property <string> label;
    callback clicked;

    height: 36px;
    width: clamp(caption.preferred-width + 54px, 120px, 300px);
    border-radius: 8px;
    background: touch.has-hover ? Theme.overlay : Theme.raised;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.faint : Theme.line;
    animate background, border-color { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label + ": " + root.text : root.text;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    caption := Text {
        x: 14px;
        width: min(self.preferred-width, parent.width - 54px);
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: center;
        accessible-role: none;
    }

    Icon {
        x: parent.width - self.width - 12px;
        source: Icons.chevron-down;
        size: 16px;
        tint: Theme.muted;
    }
}

// One selectable option in a row of choices, e.g. sort order.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    background: self.selected ? Theme.text : touch.has-hover ? Theme.press : Theme.hover;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: root.selected ? Theme.base : Theme.text;
        font-size: 13px;
        font-weight: 500;
    }
}

// Album, artist, playlist or genre in a grid or shelf.
// Calls `rested` once the pointer has stayed put briefly, so sweeping across a grid of cards
// doesn't count as interest in every one of them.
export component HoverIntent inherits Rectangle {
    in property <bool> hovered;
    callback rested;
    property <bool> fired;
    width: 0px;
    height: 0px;
    changed hovered => {
        if !self.hovered {
            self.fired = false;
        }
    }

    Timer {
        interval: 90ms;
        running: root.hovered && !root.fired;
        triggered => {
            root.fired = true;
            root.rested();
        }
    }
}

// Faint bars standing in for rows that are still loading.
export component SkeletonRows inherits Rectangle {
    in property <int> rows: 6;
    height: self.rows * 56px;

    for index in root.rows: Rectangle {
        x: 32px;
        y: index * 56px + 14px;
        width: parent.width - 64px;
        height: 28px;
        border-radius: 6px;
        background: #ffffff0d;
        opacity: 1 - index * 0.13;
    }
}

export component MediaCard inherits Rectangle {
    in property <Card> card;
    callback activated;
    callback play;
    callback menu(x: length, y: length);

    property <bool> is-genre: self.card.kind == CardKind.genre;
    property <length> art-size: self.width - 24px;
    height: self.is-genre ? 96px : self.art-size + 78px;
    border-radius: 8px;
    background: self.is-genre ? transparent : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; }

    accessible-role: button;
    accessible-label: self.card.title;
    accessible-action-default => { root.activated(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }

        HoverIntent {
            hovered: touch.has-hover;
            rested => { View.card-hovered(root.card); }
        }

        if !root.is-genre: Rectangle {
            x: 12px;
            y: 12px;
            width: root.art-size;
            height: root.art-size;

            Cover {
                art: root.card.cover;
                round: root.card.kind == CardKind.artist || root.card.kind == CardKind.outside-artist;
                placeholder: root.card.kind == CardKind.artist || root.card.kind == CardKind.outside-artist ? Icons.user-round
                    : root.card.kind == CardKind.playlist ? Icons.list-music : Icons.disc-3;
                // Cards are all drawn at one resolution so a resize doesn't refetch art.
                detail: 200px;
            }

            // An album that isn't in the library gets a button to ask for it.
            if root.card.kind == CardKind.request: PlayButton {
                x: parent.width - self.width - 8px;
                y: touch.has-hover ? parent.height - self.height - 8px : parent.height - self.height;
                size: 44px;
                opacity: touch.has-hover ? 1 : 0;
                adds: true;
                label: "Request " + root.card.title;
                animate y, opacity { duration: 160ms; easing: ease-out; }
                clicked => { root.play(); }
            }

            if root.card.kind != CardKind.artist && root.card.kind != CardKind.outside-artist && root.card.kind != CardKind.request: PlayButton {
                x: parent.width - self.width - 8px;
                y: touch.has-hover ? parent.height - self.height - 8px : parent.height - self.height;
                size: 44px;
                opacity: touch.has-hover ? 1 : 0;
                // The list that's playing gets a pause button.
                playing: Player.playing && root.card.id != "" && App.playing-source == (root.card.kind == CardKind.album ? "album:"
                    : root.card.kind == CardKind.playlist ? "playlist:"
                    : root.card.kind == CardKind.mix ? "mix:" : "none:") + root.card.id;
                label: (self.playing ? "Pause " : "Play ") + root.card.title;
                animate y, opacity { duration: 160ms; easing: ease-out; }
                clicked => { root.play(); }
            }
        }

        if !root.is-genre: Text {
            x: 12px;
            y: root.art-size + 22px;
            width: root.art-size;
            text: root.card.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }

        if !root.is-genre: Text {
            x: 12px;
            y: root.art-size + 44px;
            width: root.art-size;
            text: root.card.subtitle;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }

        if root.is-genre: Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            border-radius: 8px;
            background: touch.has-hover ? Theme.overlay : Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;
            animate background { duration: 140ms; }

            Text {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                text: root.card.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: 19px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                x: 16px;
                y: parent.height - self.height - 12px;
                text: root.card.subtitle;
                color: Theme.muted;
                font-size: 12px;
            }
        }
    }
}

// One song in a list.
export component TrackRow inherits Rectangle {
    in property <Track> track;
    in property <bool> show-cover: true;
    in property <bool> show-album: true;
    in property <bool> show-number: true;
    // Show when the song was added to the list.
    in property <bool> show-added;
    // Reordering by dragging: the row's place in its list, and the list's visible extent.
    in property <bool> can-reorder;
    in property <int> index;
    in property <int> count;
    in property <length> list-top;
    in property <length> list-bottom;
    callback activated;
    callback star;
    callback menu(x: length, y: length);
    // Dragged to a new place: the row it started as, and how far it moved.
    callback reordered(from: int, delta: int);
    callback nudge(by: length);
    // Clicked, with these modifier keys held: builds up a selection.
    callback picked(ctrl: bool, shift: bool);
    // Dragged onto a playlist or the queue.
    callback dropped(from: int, target: string);

    // This very row is what's playing (not merely the same song somewhere else).
    property <bool> current: self.track.playing;
    height: 56px;
    border-radius: 6px;
    background: self.track.selected ? Theme.press : touch.has-hover || reorder.dragging ? Theme.hover : transparent;
    opacity: reorder.dragging && reorder.origin == self.index ? 0.55 : self.track.unavailable ? 0.4 : 1;

    reorder := Reorder {
        enabled: true;
        reorder: root.can-reorder;
        droppable: true;
        label: root.track.selected && View.selection-count > 1 ? View.selection-count + " songs" : root.track.title;
        dropped(from, target) => { root.dropped(from, target); }
        index: root.index;
        count: root.count;
        list-top: root.list-top;
        list-bottom: root.list-bottom;
        moved(from, delta) => { root.reordered(from, delta); }
        nudge(by) => { root.nudge(by); }
    }

    accessible-role: list-item;
    accessible-label: self.track.title + ", " + self.track.artist;
    accessible-action-default => { root.activated(); }

    touch := TouchArea {
        mouse-cursor: reorder.dragging ? grabbing : default;
        double-clicked => { root.activated(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                reorder.press(self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                if !reorder.dragging {
                    root.picked(event.modifiers.control, event.modifiers.shift);
                }
                reorder.release();
            }
            if event.kind == PointerEventKind.cancel {
                reorder.cancel();
            }
        }
        moved => {
            if self.pressed {
                reorder.drag(self.mouse-x, self.mouse-y);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 16px;

            if root.show-number: Rectangle {
                width: 24px;

                if !touch.has-hover && !root.current: Text {
                    width: parent.width;
                    text: root.track.number;
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: right;
                }

                if !touch.has-hover && root.current: Icon {
                    x: parent.width - self.width;
                    source: Icons.bars;
                    size: 14px;
                    tint: Theme.accent-bright;
                    opacity: Player.playing ? 1 : 0.55;
                }

                if touch.has-hover: IconButton {
                    x: parent.width - self.width + 6px;
                    width: 28px;
                    height: 28px;
                    icon: root.current && Player.playing ? Icons.pause-fill : Icons.play-fill;
                    icon-size: 14px;
                    tint: Theme.text;
                    label: root.current && Player.playing ? "Pause" : "Play " + root.track.title;
                    clicked => {
                        if root.current {
                            Player.toggle();
                        } else {
                            root.activated();
                        }
                    }
                }
            }

            if root.show-cover: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;

                    Cover {
                        width: 40px;
                        height: 40px;
                        art: root.track.cover;
                        detail: 48px;
                    }

                    // With no number column to put it in, the play button goes over the cover.
                    if !root.show-number && touch.has-hover && root.track.id != "": Rectangle {
                        border-radius: 4px;
                        background: #000000a0;

                        IconButton {
                            width: 40px;
                            height: 40px;
                            icon: root.current && Player.playing ? Icons.pause-fill : Icons.play-fill;
                            icon-size: 16px;
                            tint: white;
                            hover-tint: white;
                            label: root.current && Player.playing ? "Pause" : "Play " + root.track.title;
                            clicked => {
                                if root.current {
                                    Player.toggle();
                                } else {
                                    root.activated();
                                }
                            }
                        }
                    }
                }
            }

            // Both text columns start from zero width so every row splits the space alike.
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 5;
                min-width: 80px;
                preferred-width: 0px;

                Text {
                    text: root.track.title;
                    color: root.current ? Theme.accent-bright : Theme.text;
                    font-size: 14px;
                    font-weight: 500;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    if root.track.downloaded: VerticalLayout {
                        alignment: center;
                        Icon {
                            source: Icons.circle-arrow-down;
                            size: 13px;
                            tint: Theme.accent-bright;
                        }
                    }

                    LinkText {
                        text: root.track.artist;
                        enabled: root.track.artist-id != "";
                        clicked => {
                            View.card-activated({ kind: CardKind.artist, id: root.track.artist-id, title: root.track.artist });
                        }
                    }
                }
            }

            if root.show-album: VerticalLayout {
                alignment: center;
                horizontal-stretch: 3;
                min-width: 0px;
                preferred-width: 0px;
                LinkText {
                    text: root.track.album;
                    enabled: root.track.album-id != "";
                    clicked => {
                        View.card-activated({
                            kind: CardKind.album,
                            id: root.track.album-id,
                            title: root.track.album,
                            subtitle: root.track.artist,
                            cover: root.track.cover,
                        });
                    }
                }
            }

            if root.show-added: Text {
                width: 110px;
                text: root.track.added;
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 30px;
                    height: 30px;
                    icon: root.track.starred ? Icons.heart-fill : Icons.heart;
                    icon-size: 16px;
                    tint: root.track.starred ? Theme.warm : Theme.muted;
                    hover-tint: root.track.starred ? Theme.warm : Theme.text;
                    opacity: root.track.starred || touch.has-hover ? 1 : 0;
                    label: root.track.starred ? "Remove from Liked songs" : "Add to Liked songs";
                    clicked => { root.star(); }
                }
            }

            if root.track.progress < 0: Text {
                width: 40px;
                text: root.track.duration;
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // While the song is being downloaded (or waiting to be), a bar shows how far along.
            if root.track.progress >= 0: Rectangle {
                width: 40px;
                accessible-role: progress-indicator;
                accessible-label: "Downloading " + root.track.title;
                accessible-value: round(root.track.progress * 100) + "%";
                Rectangle {
                    x: 0;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.press;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.track.progress, 0, 1);
                        border-radius: 2px;
                        background: Theme.accent-bright;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                more := IconButton {
                    width: 30px;
                    height: 30px;
                    icon: Icons.ellipsis;
                    opacity: touch.has-hover ? 1 : 0;
                    label: "More options for " + root.track.title;
                    clicked => {
                        root.menu(more.absolute-position.x, more.absolute-position.y + more.height);
                    }
                }
            }
        }
    }
}

// Shown in place of a page while it loads, or when it failed.
export component PageStatus inherits Rectangle {
    in property <bool> loading;
    in property <string> error;
    callback retry;

    VerticalLayout {
        alignment: center;
        spacing: 16px;

        if root.error != "": Text {
            text: "Couldn't load this page";
            color: Theme.text;
            font-family: Theme.display;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.muted;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.error != "": HorizontalLayout {
            alignment: center;
            TextButton {
                text: "Try again";
                clicked => { root.retry(); }
            }
        }

        if root.error == "" && root.loading: Text {
            text: "Loading…";
            color: Theme.faint;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
