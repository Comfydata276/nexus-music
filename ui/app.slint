import "fonts/HankenGrotesk-Regular.ttf";
import "fonts/HankenGrotesk-Medium.ttf";
import "fonts/HankenGrotesk-SemiBold.ttf";
import "fonts/HankenGrotesk-Bold.ttf";
import "fonts/BricolageGrotesque-SemiBold.ttf";
import "fonts/BricolageGrotesque-Bold.ttf";
import "fonts/BricolageGrotesque-ExtraBold.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, View, Player, Menu, Prompt, Toast, Lyrics, Settings, Covers, Page, Track, Card, CardKind, Shelf, CardRow, PlaylistRef, MenuEntry, LyricLine, QualityOption } from "types.slint";
import { PageStatus } from "widgets.slint";
import { Sidebar, TopBar, QueuePanel, PlayerBar } from "chrome.slint";
import { StackPage, TrackListPage, GridPage, LyricsPage, SettingsPage, LoginPage } from "pages.slint";
import { MenuOverlay, PromptOverlay, ToastOverlay } from "overlays.slint";

export { App, View, Player, Menu, Prompt, Toast, Lyrics, Settings, Covers, Icons, Page, Track, Card, CardKind, Shelf, CardRow, PlaylistRef, MenuEntry, LyricLine, QualityOption }

// The icon in the notification area, shown while closing the window keeps the app running.
export component Tray inherits SystemTrayIcon {
    in property <string> now;
    in property <bool> playing;
    in property <bool> has-track;
    in property <bool> shown <=> root.visible;
    callback open;
    callback toggle-play;
    callback next;
    callback previous;
    callback quit;

    icon: @image-url("../assets/app-icon.png");
    title: "Nexus Music";
    tooltip: root.now == "" ? "Nexus Music" : root.now;
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open Nexus Music";
            activated => { root.open(); }
        }

        MenuSeparator { }

        MenuItem {
            title: root.playing ? "Pause" : "Play";
            enabled: root.has-track;
            activated => { root.toggle-play(); }
        }

        MenuItem {
            title: "Next";
            enabled: root.has-track;
            activated => { root.next(); }
        }

        MenuItem {
            title: "Previous";
            enabled: root.has-track;
            activated => { root.previous(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component MainWindow inherits Window {
    title: Player.has-track ? Player.track.title + " - " + Player.track.artist : "Nexus Music";
    icon: @image-url("../assets/app-icon.png");
    background: Theme.base;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;
    default-font-family: "Hanken Grotesk";
    default-font-size: 14px;
    forward-focus: keys;

    // Whether the page has a cover whose colour should wash the top of the panel.
    property <bool> tinted: App.page == Page.tracklist || App.page == Page.artist;
    property <bool> liked: App.page == Page.tracklist && View.liked-songs;
    property <color> wash: self.liked ? #5b3fd6
        : self.tinted ? Covers.tint(View.cover, Covers.rev)
        : App.page == Page.home ? Theme.accent : Theme.panel;
    // The Rust side bumps this after navigating, to take the keyboard back from the search box.
    property <int> focus-request: App.main-focus;
    changed focus-request => { keys.focus(); }

    keys := FocusScope {
        key-pressed(event) => {
            if Prompt.open || !App.signed-in {
                return reject;
            }
            if event.text == " " {
                Player.toggle();
                return accept;
            }
            if event.modifiers.control && event.text == Key.RightArrow {
                Player.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                Player.previous();
                return accept;
            }
            if event.modifiers.control && event.text == Key.UpArrow {
                Player.set-volume(clamp(Player.volume + 0.05, 0, 1));
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                Player.set-volume(clamp(Player.volume - 0.05, 0, 1));
                return accept;
            }
            if event.modifiers.alt && event.text == Key.LeftArrow {
                App.go-back();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.RightArrow {
                App.go-forward();
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "l" || event.text == "f") {
                App.search-focus += 1;
                return accept;
            }
            if (event.modifiers.control && event.text == "r") || event.text == Key.F5 {
                App.refresh();
                return accept;
            }
            if event.text == Key.Escape {
                if Menu.open {
                    Menu.dismissed();
                } else {
                    self.focus();
                }
                return accept;
            }
            return reject;
        }

        // Panels are placed by hand, not by a layout, so their sizes can follow the window.
        if App.signed-in: Rectangle {
            property <length> gap: Theme.gap;
            property <length> bar: 84px;
            property <length> side: clamp(root.width * 0.22, 220px, 300px);
            // The queue steps aside when the window is too narrow to leave the page room.
            property <bool> queue-shown: App.queue-open && root.width >= 1000px;
            property <length> queue: self.queue-shown ? clamp(root.width * 0.26, 280px, 360px) : 0px;
            property <length> body: root.height - self.bar - self.gap;

            Sidebar {
                x: parent.gap;
                y: parent.gap;
                width: parent.side;
                height: parent.body;
            }

            Rectangle {
                x: parent.gap * 2 + parent.side;
                y: parent.gap;
                width: root.width - parent.side - parent.gap * 3 - (parent.queue-shown ? parent.queue + parent.gap : 0px);
                height: parent.body;
                background: Theme.panel;
                border-radius: Theme.radius;
                clip: true;

                // Mouse back and forward buttons, anywhere in the panel.
                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.back {
                            App.go-back();
                        }
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.forward {
                            App.go-forward();
                        }
                    }
                }

                Rectangle {
                    y: 0;
                    height: 360px;
                    background: @linear-gradient(180deg, root.wash.with-alpha(root.tinted ? 0.62 : App.page == Page.home ? 0.24 : 0) 0%, Theme.panel.with-alpha(0) 100%);
                    opacity: clamp(1 + View.scroll-y / 190px, 0, 1);
                }

                TopBar {
                    y: 0;
                }

                Rectangle {
                    y: 64px;
                    height: parent.height - 64px;

                    if View.loading || View.error != "": PageStatus {
                        loading: View.loading;
                        error: View.error;
                        retry => { App.refresh(); }
                    }

                    if !View.loading && View.error == "" && (App.page == Page.home || App.page == Page.search): StackPage { }
                    if !View.loading && View.error == "" && App.page == Page.artist: StackPage {
                        hero: true;
                    }
                    if !View.loading && View.error == "" && App.page == Page.tracklist: TrackListPage { }
                    if !View.loading && View.error == "" && App.page == Page.grid: GridPage { }
                    if App.page == Page.lyrics: LyricsPage { }
                    if App.page == Page.settings: SettingsPage { }
                }
            }

            if self.queue-shown: QueuePanel {
                x: root.width - parent.queue - parent.gap;
                y: parent.gap;
                width: parent.queue;
                height: parent.body;
            }

            PlayerBar {
                queue-fits: root.width >= 1000px;
                x: 0;
                y: root.height - parent.bar;
                width: root.width;
            }
        }

        if !App.signed-in: LoginPage { }

        ToastOverlay {
            y: root.height - self.height - (App.signed-in ? 100px : 32px);
        }

        if Menu.open: MenuOverlay { }

        if Prompt.open: prompt := PromptOverlay {
            init => { self.focus-input(); }
        }
    }
}
