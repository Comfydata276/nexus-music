import "fonts/HankenGrotesk-Regular.ttf";
import "fonts/HankenGrotesk-Medium.ttf";
import "fonts/HankenGrotesk-SemiBold.ttf";
import "fonts/HankenGrotesk-Bold.ttf";
import "fonts/BricolageGrotesque-SemiBold.ttf";
import "fonts/BricolageGrotesque-Bold.ttf";
import "fonts/BricolageGrotesque-ExtraBold.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Drag, App, View, Player, Menu, Prompt, Toast, Lyrics, Settings, Covers, Page, Track, Card, CardKind, Shelf, Offer, CardRow, PlaylistRef, MenuEntry, LyricLine, QualityOption, ThemeOption, Search, Suggestion, DeviceRow, BatchRequestLine } from "types.slint";
import { PageStatus, IconButton } from "widgets.slint";
import { Sidebar, TopBar, QueuePanel, PlayerBar, SearchOverlay } from "chrome.slint";
import { StackPage, TrackListPage, GridPage, LyricsPage, NowPlayingPage, SettingsPage, LoginPage, NoMusicPage } from "pages.slint";
import { MenuOverlay, PromptOverlay, ToastOverlay, NoticeOverlay } from "overlays.slint";
import { Listening, ListeningOverlay, RecentListen } from "listening.slint";

export { Theme, App, View, Player, Menu, Prompt, Toast, Lyrics, Settings, Covers, Icons, Page, Track, Card, CardKind, Shelf, Offer, CardRow, PlaylistRef, MenuEntry, LyricLine, QualityOption, ThemeOption, Search, Suggestion, DeviceRow, BatchRequestLine, Listening, RecentListen }

// The icon in the notification area, shown while closing the window keeps the app running.
export component Tray inherits SystemTrayIcon {
    in property <string> now;
    in property <bool> playing;
    in property <bool> has-track;
    in property <bool> shown <=> root.visible;
    callback open;
    callback toggle-play;
    callback next;
    callback previous;
    callback quit;

    icon: @image-url("../assets/app-icon.png");
    title: "Nexus Music";
    tooltip: root.now == "" ? "Nexus Music" : root.now;
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open Nexus Music";
            activated => { root.open(); }
        }

        MenuSeparator { }

        MenuItem {
            title: root.playing ? "Pause" : "Play";
            enabled: root.has-track;
            activated => { root.toggle-play(); }
        }

        MenuItem {
            title: "Next";
            enabled: root.has-track;
            activated => { root.next(); }
        }

        MenuItem {
            title: "Previous";
            enabled: root.has-track;
            activated => { root.previous(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

// The small player: what's playing and the buttons to steer it, in a window that stays on
// top of other apps. It's a window of its own, told what to show by the app (it doesn't share
// the main window's `Player`).
export component MiniPlayer inherits Window {
    in property <string> song;
    in property <string> artist;
    in property <image> picture;
    in property <bool> has-track;
    in property <bool> playing;
    in property <bool> starred;
    // How far through the song, 0 to 1; and the same as times, e.g. "1:02" and "3:47".
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    callback toggle;
    callback next;
    callback previous;
    callback toggle-star;
    // Back to the full window.
    callback expand;

    title: root.has-track ? root.song + " - " + root.artist : "Nexus Music";
    icon: @image-url("../assets/app-icon.png");
    background: Theme.base;
    always-on-top: true;
    preferred-width: 380px;
    min-width: 320px;
    max-width: 640px;
    min-height: 124px;
    max-height: 124px;
    default-font-family: "Hanken Grotesk";
    default-font-size: 14px;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                root.toggle();
                return accept;
            }
            if event.modifiers.control && event.text == Key.RightArrow {
                root.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                root.previous();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;

        Rectangle {
            width: 100px;
            height: 100px;
            border-radius: 8px;
            background: Theme.raised;
            clip: true;

            if art.source.width == 0: Image {
                width: 36px;
                height: 36px;
                source: Icons.music;
                colorize: Theme.faint;
            }

            art := Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: root.picture;
                accessible-role: none;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.has-track ? root.song : "Nothing playing";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    text: root.artist;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.elapsed;
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.raised;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.progress, 0, 1);
                            height: 100%;
                            border-radius: 2px;
                            background: Theme.accent-bright;
                        }
                    }
                }

                Text {
                    text: root.total;
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    icon: root.starred ? Icons.heart-fill : Icons.heart;
                    icon-size: 17px;
                    tint: root.starred ? Theme.warm : Theme.muted;
                    enabled: root.has-track;
                    label: root.starred ? "Remove from Liked songs" : "Add to Liked songs";
                    clicked => { root.toggle-star(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: Icons.prev-fill;
                    icon-size: 16px;
                    enabled: root.has-track;
                    label: "Previous";
                    clicked => { root.previous(); }
                }

                IconButton {
                    icon: root.playing ? Icons.pause-fill : Icons.play-fill;
                    icon-size: 20px;
                    tint: Theme.text;
                    enabled: root.has-track;
                    label: root.playing ? "Pause" : "Play";
                    clicked => { root.toggle(); }
                }

                IconButton {
                    icon: Icons.next-fill;
                    icon-size: 16px;
                    enabled: root.has-track;
                    label: "Next";
                    clicked => { root.next(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: Icons.maximize-2;
                    icon-size: 16px;
                    label: "Back to the full window";
                    clicked => { root.expand(); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: Player.has-track ? Player.track.title + " - " + Player.track.artist : "Nexus Music";
    icon: @image-url("../assets/app-icon.png");
    background: Theme.base;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;
    default-font-family: "Hanken Grotesk";
    default-font-size: 14px;
    forward-focus: keys;

    // Whether the page has a cover whose colour should wash the top of the panel.
    property <bool> tinted: App.page == Page.tracklist || App.page == Page.artist || App.page == Page.now-playing;
    property <bool> liked: App.page == Page.tracklist && View.liked-songs;
    property <color> wash: self.liked ? Theme.accent.darker(0.25)
        : App.page == Page.now-playing ? Covers.tint(Player.track.cover, Covers.rev)
        : self.tinted ? Covers.tint(View.cover, Covers.rev)
        : App.page == Page.home ? Theme.accent : Theme.panel;
    // The queue panel is on screen and showing what's coming up, so the keyboard can go to it.
    // Wide enough for the queue to sit beside the page and leave the page room.
    property <bool> wide: self.width >= 1100px;
    changed wide => {
        if self.wide {
            App.queue-over = false;
        }
    }
    property <bool> queue-usable: (self.wide ? App.queue-open : App.queue-over) && App.queue-tab == 0 && Player.queue.length > 0;
    // The account in use, as one value: a change to it is called out after the Rust side has
    // finished publishing it.
    // (Only for the Nexus server's component, and only once it is switched on: until then
    // this reads nothing else and never changes.)
    property <string> account: App.nexus-on && App.signed-in ? App.server + "\n" + App.username : "";
    changed account => { App.account-changed(); }
    // The Rust side bumps this after navigating, to take the keyboard back from the search box.
    property <int> focus-request: App.main-focus;
    changed focus-request => { keys.focus(); }

    keys := FocusScope {
        key-pressed(event) => {
            if Listening.page != "" || App.nexus-notice != "" || Prompt.open || !App.signed-in || App.show-sign-in {
                return reject;
            }
            // A menu that's open takes the arrow keys and Enter.
            if Menu.open && event.text == Key.DownArrow {
                Menu.move(1);
                return accept;
            }
            if Menu.open && event.text == Key.UpArrow {
                Menu.move(-1);
                return accept;
            }
            if Menu.open && event.text == Key.Return {
                Menu.accept();
                return accept;
            }
            if event.text == " " {
                Player.toggle();
                return accept;
            }
            if event.modifiers.control && event.text == Key.RightArrow {
                Player.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                Player.previous();
                return accept;
            }
            if event.modifiers.control && event.text == Key.UpArrow {
                Player.set-volume(clamp(Player.volume + 0.05, 0, 1));
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                Player.set-volume(clamp(Player.volume - 0.05, 0, 1));
                return accept;
            }
            if event.modifiers.alt && event.text == Key.LeftArrow {
                App.go-back();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.RightArrow {
                App.go-forward();
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "l" || event.text == "f") {
                App.search-focus += 1;
                return accept;
            }
            if event.modifiers.control && event.text == "," {
                if App.route == "settings" {
                    App.go-back();
                } else {
                    App.navigate("settings");
                }
                return accept;
            }
            if event.modifiers.control && event.text == "z" {
                App.undo();
                return accept;
            }
            if (event.modifiers.control && event.text == "r") || event.text == Key.F5 {
                App.refresh();
                return accept;
            }
            if event.text == Key.Escape {
                if Menu.open {
                    Menu.dismissed();
                } else if View.selection-count > 0 {
                    View.clear-selection();
                } else {
                    self.focus();
                }
                return accept;
            }
            if event.modifiers.control && event.text == "a" && (App.page == Page.tracklist || App.page == Page.search || App.page == Page.artist) {
                View.select-all();
                return accept;
            }
            if event.modifiers.control || event.modifiers.meta {
                return reject;
            }
            // Tab or F6 moves the arrow keys between the page and the queue panel.
            if (event.text == Key.Tab || event.text == Key.F6) && !event.modifiers.alt && root.queue-usable {
                App.keys-in-queue = !App.keys-in-queue;
                if App.keys-in-queue && Player.queue-cursor < 0 {
                    Player.queue-cursor = 0;
                }
                return accept;
            }
            if App.keys-in-queue && root.queue-usable {
                if event.text == Key.DownArrow && event.modifiers.alt && Player.queue-cursor >= 0 && Player.queue-cursor < Player.queue.length - 1 {
                    Player.queue-moved(Player.queue-cursor, 1);
                    Player.queue-cursor += 1;
                    return accept;
                }
                if event.text == Key.UpArrow && event.modifiers.alt && Player.queue-cursor > 0 {
                    Player.queue-moved(Player.queue-cursor, -1);
                    Player.queue-cursor -= 1;
                    return accept;
                }
                // The heading between the queue's two parts is a row, but not one to stop on.
                if event.text == Key.DownArrow {
                    Player.queue-cursor = min(Player.queue.length - 1, Player.queue-cursor + 1);
                    if Player.queue-cursor == Player.queue-gap {
                        Player.queue-cursor += 1;
                    }
                    return accept;
                }
                if event.text == Key.UpArrow {
                    Player.queue-cursor = max(0, Player.queue-cursor - 1);
                    if Player.queue-cursor == Player.queue-gap {
                        Player.queue-cursor -= 1;
                    }
                    return accept;
                }
                if event.text == Key.Return && Player.queue-cursor >= 0 {
                    Player.queue-activated(Player.queue-cursor);
                    return accept;
                }
                if (event.text == Key.Delete || event.text == Key.Backspace) && Player.queue-cursor >= 0 {
                    Player.queue-remove(Player.queue-cursor);
                    return accept;
                }
            }
            if event.modifiers.alt {
                return reject;
            }
            if event.text == Key.LeftArrow {
                Player.seek-by(-5);
                return accept;
            }
            if event.text == Key.RightArrow {
                Player.seek-by(5);
                return accept;
            }
            if event.text == "m" {
                Player.toggle-mute();
                return accept;
            }
            if !App.keys-in-queue && (App.page == Page.tracklist || App.page == Page.search || App.page == Page.artist) {
                if event.text == Key.DownArrow {
                    View.move-selection(1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    View.move-selection(-1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageDown {
                    View.move-selection(10, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageUp {
                    View.move-selection(-10, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.Home {
                    View.move-selection(-1000000, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.End {
                    View.move-selection(1000000, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.Return && View.cursor-row >= 0 {
                    View.activate-selection();
                    return accept;
                }
                if event.text == Key.Delete && View.cursor-row >= 0 {
                    View.remove-selection();
                    return accept;
                }
                // The menu key, or Shift+F10: what right-clicking the row would offer.
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && View.cursor-row >= 0 {
                    View.track-menu(View.cursor-row, root.width * 0.45, root.height * 0.4);
                    return accept;
                }
            }
            return reject;
        }

        // Panels are placed by hand, not by a layout, so their sizes can follow the window.
        if App.signed-in: Rectangle {
            property <length> gap: Theme.gap;
            property <length> bar: 84px;
            // The top bar's height: panels start below it.
            property <length> top: 60px;
            property <length> side: clamp(root.width * 0.22, 220px, 300px);
            // The panel at the side holds the queue. In a window too narrow to leave the page room beside it, the panel lies over
            // the page's right-hand side instead of squeezing it, and only when asked for.
            property <bool> queue-shown: (root.wide ? App.queue-open : App.queue-over);
            property <length> queue: self.queue-shown ? clamp(root.width * 0.26, 280px, 360px) : 0px;
            property <bool> queue-beside: self.queue-shown && root.wide;
            property <length> body: root.height - self.bar - self.top;

            Sidebar {
                x: parent.gap;
                y: parent.top;
                width: parent.side;
                height: parent.body;
            }

            Rectangle {
                x: parent.gap * 2 + parent.side;
                y: parent.top;
                width: root.width - parent.side - parent.gap * 3 - (parent.queue-beside ? parent.queue + parent.gap : 0px);
                height: parent.body;
                background: Theme.panel;
                border-radius: Theme.radius;
                clip: true;

                // Mouse back and forward buttons, anywhere in the panel.
                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.back {
                            App.go-back();
                        }
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.forward {
                            App.go-forward();
                        }
                    }
                }

                Rectangle {
                    y: 0;
                    height: 360px;
                    background: @linear-gradient(180deg, root.wash.with-alpha(root.tinted ? 0.62 : App.page == Page.home ? 0.24 : 0) 0%, Theme.panel.with-alpha(0) 100%);
                    opacity: App.page == Page.now-playing ? 1 : clamp(1 + View.scroll-y / 190px, 0, 1);
                }

                Rectangle {
                    y: 12px;
                    height: parent.height - 12px;

                    if View.loading || View.error != "": PageStatus {
                        loading: View.loading;
                        error: View.error;
                        retry => { App.refresh(); }
                    }

                    if !View.loading && View.error == "" && (App.page == Page.home || App.page == Page.search): StackPage { }
                    if !View.loading && View.error == "" && App.page == Page.artist: StackPage {
                        hero: true;
                    }
                    if !View.loading && View.error == "" && App.page == Page.tracklist: TrackListPage { }
                    if !View.loading && View.error == "" && App.page == Page.grid: GridPage { }
                    if App.page == Page.lyrics: LyricsPage { }
                    if App.page == Page.now-playing: NowPlayingPage { }
                    if App.page == Page.settings: SettingsPage { }
                }
            }

            if self.queue-shown: QueuePanel {
                x: root.width - parent.queue - parent.gap;
                y: parent.top;
                width: parent.queue;
                height: parent.body;
                over: !parent.queue-beside;
            }

            PlayerBar {
                wide: root.wide;
                x: 0;
                y: root.height - parent.bar;
                width: root.width;
            }
        }

        // Signed in with no music login yet: a screen of its own, with the account's own
        // actions; never the sign-in form (src/nexus/signin.rs).
        if !App.signed-in && App.nexus-signed-in && !App.show-sign-in: NoMusicPage { }
        if (!App.signed-in && !App.nexus-signed-in && !App.nexus-starting) || App.show-sign-in: LoginPage { }

        // Above everything else, including the sign-in screen: it's how the window is moved
        // and closed.
        top := TopBar {
            x: 0;
            y: 0;
            width: root.width;
        }

        if App.signed-in && Search.open && Search.items.length > 0: SearchOverlay {
            anchor-x: top.search-x;
            anchor-width: top.search-width;
        }

        ToastOverlay {
            y: root.height - self.height - (App.signed-in ? 100px : 32px);
        }

        // What's being dragged, following the pointer.
        if Drag.active: Rectangle {
            x: min(Drag.x + 14px, root.width - self.width - 8px);
            y: min(Drag.y + 12px, root.height - self.height - 8px);
            width: min(drag-label.preferred-width + 28px, 280px);
            height: 34px;
            border-radius: 17px;
            background: Drag.target != "" ? Theme.accent : Theme.overlay;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;

            drag-label := Text {
                width: parent.width - 28px;
                text: Drag.label;
                color: Drag.target != "" ? white : Theme.text;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        if Menu.open: MenuOverlay { }

        if Prompt.open: prompt := PromptOverlay {
            init => { self.focus-input(); }
        }

        if Listening.page != "": ListeningOverlay { }
        if App.nexus-notice != "": NoticeOverlay { }
    }
}
