// The screens shown in the main panel.

import { ScrollView, ListView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, View, Player, Lyrics, Settings, Covers, Card, CardKind, Shelf, Page, QualityOption, ThemeOption, Track } from "types.slint";
import { Icon, IconButton, PlayButton, TextButton, LinkText, Cover, Field, Toggle, Chip, Slider, MediaCard, TrackRow, PageStatus, HoverIntent, SkeletonRows, ScrollThumb } from "widgets.slint";

// Cover, title and summary at the top of an album, playlist or artist.
component Hero inherits Rectangle {
    property <length> art: clamp(self.width * 0.24, 140px, 232px);
    height: self.art + 48px;

    HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 16px;
        padding-bottom: 24px;
        spacing: 24px;

        Rectangle {
            width: root.art;
            height: root.art;
            border-radius: View.cover-round ? root.art / 2 : 8px;
            background: Theme.raised;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000080;

            if View.liked-songs: Rectangle {
                border-radius: 8px;
                background: @linear-gradient(135deg, Theme.accent.darker(0.25) 0%, Theme.warm 100%);
                Icon {
                    source: Icons.heart-fill;
                    size: root.art * 0.34;
                    tint: white;
                }
            }

            if !View.liked-songs: Cover {
                art: View.cover;
                round: View.cover-round;
                placeholder: View.cover-round ? Icons.user-round : Icons.disc-3;
                detail: root.art;
            }
        }

        VerticalLayout {
            alignment: end;
            spacing: 8px;

            Text {
                text: View.label;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }

            Text {
                text: View.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: View.title.character-count > 34 ? 30px : View.title.character-count > 18 ? 42px : 60px;
                font-weight: 800;
                wrap: word-wrap;
                max-lines: 2;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                spacing: 8px;

                if View.subtitle != "": LinkText {
                    text: View.subtitle;
                    ink: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    enabled: View.subtitle-route != "";
                    clicked => { App.navigate(View.subtitle-route); }
                }

                Text {
                    text: View.meta;
                    color: Theme.muted;
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
    }
}

// The box that narrows a playlist to songs matching what's typed. Closed, it's just the icon.
component FilterBox inherits Rectangle {
    property <bool> expanded: input.has-focus || View.filter != "";
    width: self.expanded ? 220px : 40px;
    height: 40px;
    border-radius: 20px;
    background: self.expanded ? Theme.raised : open.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-bright : transparent;
    animate width { duration: 140ms; easing: ease-out; }

    open := TouchArea {
        mouse-cursor: root.expanded ? text : pointer;
        clicked => { input.focus(); }
    }

    Icon {
        x: 11px;
        source: Icons.search;
        size: 18px;
        tint: root.expanded || open.has-hover ? Theme.text : Theme.muted;
    }

    if root.expanded && View.filter == "": Text {
        x: 38px;
        width: parent.width - 48px;
        text: "Find in this list";
        color: Theme.faint;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    input := TextInput {
        x: 38px;
        width: max(0px, parent.width - 38px - 34px);
        text <=> View.filter;
        visible: root.expanded;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent;
        selection-foreground-color: white;
        accessible-label: "Find in this list";
        edited => { View.set-filter(self.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                View.filter = "";
                View.set-filter("");
                self.clear-focus();
                return accept;
            }
            return reject;
        }
    }

    if View.filter != "": IconButton {
        x: parent.width - self.width - 6px;
        width: 28px;
        height: 28px;
        icon: Icons.x;
        icon-size: 15px;
        label: "Clear";
        clicked => {
            View.filter = "";
            View.set-filter("");
            input.focus();
        }
    }
}

component SortButton inherits Rectangle {
    height: 40px;
    width: row.preferred-width;
    border-radius: 20px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: "Sort: " + View.track-sort;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { View.choose-track-sort(root.absolute-position.x, root.absolute-position.y + root.height + 4px); }
    }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: View.track-sort;
            color: touch.has-hover || !View.track-sort-custom ? Theme.text : Theme.muted;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: View.track-sort-custom ? Icons.chevron-down : View.track-sort-descending ? Icons.arrow-down : Icons.arrow-up;
                size: 15px;
                tint: touch.has-hover || !View.track-sort-custom ? Theme.text : Theme.muted;
            }
        }
    }
}

component ActionBar inherits Rectangle {
    height: 72px;

    HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        spacing: 16px;

        if View.can-play: VerticalLayout {
            alignment: center;
            PlayButton {
                size: 54px;
                playing: View.playing-here && Player.playing;
                label: (self.playing ? "Pause " : "Play ") + View.title;
                clicked => { View.play(); }
            }
        }

        // Sets whether this list plays shuffled; it doesn't start anything playing.
        if View.can-play: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;

                IconButton {
                    width: 40px;
                    height: 40px;
                    icon: Icons.shuffle;
                    icon-size: 22px;
                    active: View.shuffle;
                    label: View.shuffle ? "Turn off shuffle for " + View.title : "Turn on shuffle for " + View.title;
                    clicked => { View.toggle-shuffle(); }
                }

                if View.shuffle: Rectangle {
                    y: 34px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.accent-bright;
                }
            }
        }

        if View.can-star: VerticalLayout {
            alignment: center;
            IconButton {
                width: 40px;
                height: 40px;
                icon: View.starred ? Icons.heart-fill : Icons.heart;
                icon-size: 22px;
                tint: View.starred ? Theme.warm : Theme.muted;
                hover-tint: View.starred ? Theme.warm : Theme.text;
                label: View.starred ? "Remove from liked albums" : "Add to liked albums";
                clicked => { View.toggle-star(); }
            }
        }

        if View.can-download && View.download-state != 1: VerticalLayout {
            alignment: center;
            IconButton {
                width: 40px;
                height: 40px;
                icon: View.download-state == 2 ? Icons.circle-arrow-down : Icons.download;
                icon-size: 22px;
                active: View.download-state == 2;
                label: View.download-state == 2 ? "Remove from downloads" : "Download";
                clicked => { View.download(); }
            }
        }

        // While downloading: a ring that fills as songs arrive, with a stop button in it, and
        // the count beside it.
        if View.can-download && View.download-state == 1: HorizontalLayout {
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    property <float> turn: clamp(View.download-progress, 0.02, 0.995);
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: stop.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: "Cancel downloading";
                    accessible-action-default => { View.download(); }

                    stop := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { View.download(); }
                    }

                    Path {
                        width: 28px;
                        height: 28px;
                        viewbox-width: 28;
                        viewbox-height: 28;
                        commands: "M 14 2 A 12 12 0 1 1 13.99 2";
                        stroke: Theme.press;
                        stroke-width: 3px;
                        fill: transparent;
                    }

                    Path {
                        width: 28px;
                        height: 28px;
                        viewbox-width: 28;
                        viewbox-height: 28;
                        commands: "M 14 2 A 12 12 0 " + (parent.turn > 0.5 ? "1" : "0") + " 1 "
                            + (14 + 12 * sin(parent.turn * 360deg)) + " " + (14 - 12 * cos(parent.turn * 360deg));
                        stroke: Theme.accent-bright;
                        stroke-width: 3px;
                        fill: transparent;
                    }

                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 2px;
                        background: stop.has-hover ? Theme.text : Theme.muted;
                    }
                }
            }

            Text {
                text: View.download-done + " / " + View.download-total;
                color: Theme.muted;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if View.has-menu: VerticalLayout {
            alignment: center;
            more := IconButton {
                width: 40px;
                height: 40px;
                icon: Icons.ellipsis;
                icon-size: 22px;
                label: "More options";
                clicked => { View.header-menu(more.absolute-position.x, more.absolute-position.y + more.height); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if View.can-filter: VerticalLayout {
            alignment: center;
            FilterBox { }
        }

        if View.can-filter: VerticalLayout {
            alignment: center;
            SortButton { }
        }
    }
}

// A column's heading. Clicking it sorts the list by that column: one way, then the other,
// then back to the list's own order.
component HeaderCell inherits Rectangle {
    in property <string> text;
    // Shown in place of the text when there is none.
    in property <image> icon;
    in property <int> column;
    // Sits at the right of its space instead of the left.
    in property <bool> trailing;
    property <bool> active: View.track-sort-index == self.column;
    property <brush> ink: self.active || touch.has-hover ? Theme.text : Theme.muted;

    accessible-role: button;
    accessible-label: "Sort by " + (self.text != "" ? self.text : "length");
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { View.sort-column(root.column); }
    }

    HorizontalLayout {
        alignment: root.trailing ? end : start;
        spacing: 6px;

        if root.active && root.trailing: VerticalLayout {
            alignment: center;
            Icon {
                source: View.track-sort-descending ? Icons.arrow-down : Icons.arrow-up;
                size: 14px;
                tint: Theme.accent-bright;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-size: 13px;
            vertical-alignment: center;
        }

        if root.text == "": VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 15px;
                tint: root.ink;
            }
        }

        if root.active && !root.trailing: VerticalLayout {
            alignment: center;
            Icon {
                source: View.track-sort-descending ? Icons.arrow-down : Icons.arrow-up;
                size: 14px;
                tint: Theme.accent-bright;
            }
        }
    }
}

component ColumnHeader inherits Rectangle {
    in property <bool> show-added;
    height: 36px;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 28px;
        spacing: 16px;

        if View.show-number: Text {
            width: 24px;
            text: "#";
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if View.show-cover: Rectangle {
            width: 40px;
        }

        HeaderCell {
            horizontal-stretch: 5;
            min-width: 80px;
            preferred-width: 0px;
            text: "Title";
            column: 1;
        }

        if View.show-album: HeaderCell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: "Album";
            column: 3;
        }

        if root.show-added: HeaderCell {
            width: 110px;
            text: "Date added";
            column: 5;
        }

        // Same width as a row's heart, duration and menu button, so the columns line up.
        HorizontalLayout {
            width: 132px;
            padding-right: 46px;
            HeaderCell {
                icon: Icons.clock-3;
                column: 4;
                trailing: true;
            }
        }
    }

    Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.line;
    }
}

component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <string> route;
    height: 44px;

    HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-family: Theme.display;
            font-size: 22px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.route != "": VerticalLayout {
            alignment: center;
            LinkText {
                text: "Show all";
                font-weight: 600;
                clicked => { App.navigate(root.route); }
            }
        }
    }
}

component ShelfView inherits Rectangle {
    in property <Shelf> shelf;
    property <bool> genres: self.shelf.cards.length > 0 && self.shelf.cards[0].kind == CardKind.genre;
    property <length> avail: self.width - 24px;
    property <int> cols: max(2, floor(self.avail / (self.genres ? 220px : 188px)));
    property <length> card-width: floor(self.avail / self.cols / 1px) * 1px;
    property <int> rows: self.shelf.wrap ? ceil(self.shelf.cards.length / self.cols) : 1;
    property <length> row-height: self.genres ? 96px : self.card-width - 24px + 78px;

    height: 44px + self.rows * self.row-height + 4px;

    SectionTitle {
        y: 0;
        text: root.shelf.title;
        route: root.shelf.route;
    }

    for card[index] in root.shelf.cards: Rectangle {
        property <bool> shown: index < root.rows * root.cols;
        x: 12px + Math.mod(index, root.cols) * root.card-width;
        y: 44px + floor(index / root.cols) * root.row-height;
        width: root.card-width;
        height: root.row-height;

        if self.shown: MediaCard {
            width: parent.width;
            card: card;
            activated => { View.card-activated(card); }
            play => { View.card-play(card); }
            menu(x, y) => { View.card-menu(card, x, y); }
        }
    }
}

// A compact album tile for the top of Home.
component QuickTile inherits Rectangle {
    in property <Card> card;
    height: 56px;
    border-radius: 6px;
    background: touch.has-hover ? #ffffff26 : #ffffff14;
    clip: true;
    animate background { duration: 140ms; }

    accessible-role: button;
    accessible-label: self.card.title;
    accessible-action-default => { View.card-activated(root.card); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { View.card-activated(root.card); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                View.card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }

        HoverIntent {
            hovered: touch.has-hover;
            rested => { View.card-hovered(root.card); }
        }

        Rectangle {
            x: 0;
            width: 56px;
            height: 56px;
            Cover {
                art: root.card.cover;
                border-radius: 0;
                placeholder: Icons.disc-3;
                detail: 64px;
            }
        }

        Text {
            x: 68px;
            width: parent.width - 68px - (touch.has-hover ? 52px : 12px);
            text: root.card.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        if touch.has-hover: PlayButton {
            x: parent.width - self.width - 8px;
            size: 36px;
            playing: Player.playing && App.playing-source == "album:" + root.card.id;
            label: (self.playing ? "Pause " : "Play ") + root.card.title;
            clicked => { View.card-play(root.card); }
        }
    }
}

component TileGrid inherits Rectangle {
    property <length> avail: self.width - 2 * Theme.page-pad;
    property <int> cols: self.avail > 880px ? 4 : self.avail > 560px ? 3 : 2;
    property <length> tile-width: (self.avail - (self.cols - 1) * 10px) / self.cols;
    property <int> shown: min(View.tiles.length, self.cols * 2);
    height: ceil(self.shown / self.cols) * 66px;

    for card[index] in View.tiles: Rectangle {
        x: Theme.page-pad + Math.mod(index, root.cols) * (root.tile-width + 10px);
        y: floor(index / root.cols) * 66px;
        width: root.tile-width;
        height: 56px;
        if index < root.shown: QuickTile {
            card: card;
        }
    }
}

// Home, search results and artist pages: a title or hero, then songs, then shelves.
export component StackPage inherits Rectangle {
    in property <bool> hero;

    scroll := ScrollView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        content-y <=> View.scroll-y;

        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;
            spacing: 8px;
            padding-bottom: 32px;

            if root.hero: Hero { }
            if root.hero: ActionBar { }

            if !root.hero && View.title != "": HorizontalLayout {
                padding-left: Theme.page-pad;
                padding-right: Theme.page-pad;
                padding-top: 8px;
                padding-bottom: 12px;
                spacing: 16px;
                Text {
                    horizontal-stretch: 1;
                    text: View.title;
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 34px;
                    font-weight: 800;
                    overflow: elide;
                }

                if View.action != "": VerticalLayout {
                    alignment: center;
                    TextButton {
                        primary: true;
                        text: View.action;
                        clicked => { View.action-clicked(); }
                    }
                }
            }

            if View.tiles.length > 0: TileGrid { }
            if View.tiles.length > 0: Rectangle {
                height: 12px;
            }

            if View.pending: SkeletonRows {
                rows: 4;
            }

            if View.empty != "": VerticalLayout {
                padding: Theme.page-pad;
                padding-top: 48px;
                Text {
                    text: View.empty;
                    color: Theme.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            for shelf in View.lead: ShelfView {
                shelf: shelf;
            }

            if View.tracks.length > 0 && View.tracks-title != "": SectionTitle {
                text: View.tracks-title;
            }

            for track[index] in View.tracks: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                TrackRow {
                    track: track;
                    show-album: View.show-album;
                    show-cover: View.show-cover;
                    show-number: View.show-number;
                    index: index;
                    count: View.tracks.length;
                    activated => { View.track-activated(index); }
                    star => { View.track-star(index); }
                    menu(x, y) => { View.track-menu(index, x, y); }
                    picked(ctrl, shift) => { View.track-clicked(index, ctrl, shift); }
                    dropped(from, target) => { View.rows-dropped(from, target); }
                }
            }

            for shelf in View.shelves: ShelfView {
                shelf: shelf;
            }

            if View.about != "": VerticalLayout {
                padding-left: Theme.page-pad;
                padding-right: Theme.page-pad;
                padding-top: 16px;
                spacing: 12px;

                Text {
                    text: "About";
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    max-width: 720px;
                    text: View.about;
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
    }

    ScrollThumb {
        x: parent.width - self.width;
        content-y <=> scroll.content-y;
        content-height: scroll.content-height;
        visible-height: scroll.visible-height;
    }
}

// Albums, playlists and Liked songs. The list is virtualised, so the hero is part of row 0.
export component TrackListPage inherits Rectangle {
    // The page is one scrolling sheet: the cover and title, room for the action bar, the column
    // header, the songs, then any shelves. Songs all have the same height, so the page works out
    // for itself which ones are in view and only those exist at any moment. (A long playlist
    // would otherwise mean thousands of rows.)
    property <length> hero-height: clamp(self.width * 0.24, 140px, 232px) + 48px;
    property <length> row-height: 56px;
    property <length> section-height: 44px;
    property <length> header-height: self.hero-height + 72px + 36px + 8px;
    property <length> rows-height: View.tracks.length * self.row-height + View.track-sections * self.section-height;
    property <length> scrolled: -View.scroll-y;
    property <int> first: max(0, floor((self.scrolled - self.header-height) / self.row-height) - View.track-sections - 2);
    property <int> shown: max(0, min(View.tracks.length - self.first, ceil(self.height / self.row-height) + View.track-sections + 5));
    // The play and filter controls sit over the sheet and stick to the top once the cover has
    // scrolled away.
    property <length> bar-y: max(0px, self.hero-height - self.scrolled);
    property <bool> stuck: self.scrolled > self.hero-height;
    // The date column gives way first when the window is narrow.
    property <bool> show-added: View.show-added && self.width >= 860px;

    scroll := ScrollView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        content-y <=> View.scroll-y;
        content-width: self.visible-width;
        content-height: root.header-height + root.rows-height + shelves.preferred-height + (View.tracks.length == 0 ? 160px : 0px);
        // A list that gets shorter (songs removed, a filter typed) mustn't stay scrolled past its end.
        changed content-height => {
            self.content-y = max(self.content-y, min(0px, self.visible-height - self.content-height));
        }

        Hero {
            x: 0;
            y: 0;
            width: scroll.visible-width;
        }

        if View.tracks.length > 0: ColumnHeader {
            x: 0;
            y: root.hero-height + 72px;
            width: scroll.visible-width;
            show-added: root.show-added;
        }

        if View.tracks.length == 0 && View.pending: SkeletonRows {
            x: 0;
            y: root.hero-height + 72px;
            width: scroll.visible-width;
        }

        if View.tracks.length == 0 && !View.pending: Text {
            x: 24px;
            y: root.hero-height + 72px + 24px;
            width: scroll.visible-width - 48px;
            text: View.empty;
            color: Theme.muted;
            font-size: 15px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        for slot in root.shown: row := Rectangle {
            property <int> index: root.first + slot;
            property <Track> track: View.tracks[self.index];
            x: 0;
            y: root.header-height + self.index * root.row-height + self.track.sections-before * root.section-height;
            width: scroll.visible-width;
            height: root.row-height;

            if self.track.section != "": HorizontalLayout {
                y: -root.section-height;
                height: root.section-height;
                padding-left: 32px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.disc-3;
                        size: 16px;
                    }
                }

                Text {
                    text: row.track.section;
                    color: Theme.muted;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            TrackRow {
                x: 16px;
                width: row.width - 32px;
                track: row.track;
                show-album: View.show-album;
                show-cover: View.show-cover;
                show-number: View.show-number;
                show-added: root.show-added;
                can-reorder: View.can-reorder;
                index: row.index;
                count: View.tracks.length;
                list-top: scroll.absolute-position.y + (root.stuck ? 72px : 0px);
                list-bottom: scroll.absolute-position.y + scroll.height;
                activated => { View.track-activated(row.index); }
                star => { View.track-star(row.index); }
                menu(x, y) => { View.track-menu(row.index, x, y); }
                picked(ctrl, shift) => { View.track-clicked(row.index, ctrl, shift); }
                dropped(from, target) => { View.rows-dropped(from, target); }
                reordered(from, delta) => { View.track-moved(from, delta); }
                nudge(by) => {
                    scroll.content-y = clamp(scroll.content-y + by, min(0px, scroll.visible-height - scroll.content-height), 0px);
                }
            }
        }

        shelves := VerticalLayout {
            x: 0;
            y: root.header-height + root.rows-height;
            width: scroll.visible-width;
            padding-top: View.shelves.length > 0 ? 24px : 0px;
            padding-bottom: 32px;
            for shelf in View.shelves: ShelfView {
                shelf: shelf;
            }
        }
    }

    ScrollThumb {
        x: parent.width - self.width;
        content-y <=> scroll.content-y;
        content-height: scroll.content-height;
        visible-height: scroll.visible-height;
    }

    Rectangle {
        x: 0;
        y: root.bar-y;
        width: parent.width - 14px;
        height: 72px;
        background: root.stuck ? Theme.panel : transparent;

        ActionBar { }

        if root.stuck: Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }
    }
}

// Every album or artist in the library, loaded a page at a time as you scroll.
export component GridPage inherits Rectangle {
    property <bool> genres: View.grid.length > 0 && View.grid[0].cards.length > 0 && View.grid[0].cards[0].kind == CardKind.genre;
    property <length> avail: self.width - 24px - 14px;
    property <int> cols: max(2, floor(self.avail / (self.genres ? 220px : 188px)));
    property <length> card-width: floor(self.avail / self.cols / 1px) * 1px;
    changed cols => { View.columns-changed(self.cols); }
    init => { View.columns-changed(self.cols); }

    VerticalLayout {
        HorizontalLayout {
            padding-left: Theme.page-pad;
            padding-right: Theme.page-pad;
            padding-top: 8px;
            padding-bottom: 12px;
            Text {
                text: View.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: 34px;
                font-weight: 800;
                overflow: elide;
            }
        }

        if View.sorts.length > 0: HorizontalLayout {
            padding-left: Theme.page-pad;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: start;
            for name[index] in View.sorts: Chip {
                text: name;
                selected: index == View.sort;
                clicked => { View.set-sort(index); }
            }
        }

        if View.empty != "": Text {
            text: View.empty;
            color: Theme.muted;
            font-size: 15px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            list := ListView {
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                content-y <=> View.scroll-y;
                scrolled => {
                    if -self.content-y + self.visible-height > self.content-height - 900px {
                        View.near-end();
                    }
                }

                for row in View.grid: HorizontalLayout {
                    padding-left: 12px;
                    alignment: start;
                    for card in row.cards: MediaCard {
                        width: root.card-width;
                        card: card;
                        activated => { View.card-activated(card); }
                        play => { View.card-play(card); }
                        menu(x, y) => { View.card-menu(card, x, y); }
                    }
                }
            }

            ScrollThumb {
                x: parent.width - self.width;
                content-y <=> list.content-y;
                content-height: list.content-height;
                visible-height: list.visible-height;
            }
        }
    }
}

export component LyricsPage inherits Rectangle {
    if Lyrics.lines.length == 0: VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: Lyrics.status;
            color: Theme.muted;
            font-family: Theme.display;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if Lyrics.lines.length > 0: Rectangle {
        scroll := ScrollView {
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                width: scroll.visible-width;
                alignment: start;
                padding-left: 48px;
                padding-right: 48px;
                padding-top: 32px;
                padding-bottom: 160px;
                spacing: 14px;

                for line[index] in Lyrics.lines: Rectangle {
                    property <bool> active: Lyrics.timed && index == Lyrics.active;
                    property <bool> past: Lyrics.timed && index < Lyrics.active;
                    height: label.preferred-height;
                    changed active => {
                        if self.active {
                            anchor.ensure-visible(ScrollBehavior.smooth);
                        }
                    }

                    // Taller than the line, so scrolling it into view leaves room around the lyric.
                    anchor := Rectangle {
                        y: -120px;
                        height: parent.height + 360px;
                    }

                    label := Text {
                        x: 0;
                        width: parent.width;
                        text: line.text == "" ? "♪" : line.text;
                        color: parent.active || !Lyrics.timed ? Theme.text : touch.has-hover ? Theme.text : parent.past ? Theme.faint : Theme.muted;
                        font-family: Theme.display;
                        font-size: 28px;
                        font-weight: 700;
                        wrap: word-wrap;
                        animate color { duration: 200ms; }
                    }

                    touch := TouchArea {
                        enabled: Lyrics.timed && line.time >= 0;
                        mouse-cursor: self.enabled ? pointer : default;
                        clicked => { Player.seek(line.time); }
                    }
                }
            }
        }

        ScrollThumb {
            x: parent.width - self.width;
            content-y <=> scroll.content-y;
            content-height: scroll.content-height;
            visible-height: scroll.visible-height;
        }
    }
}

// A screen built around the song that's playing: its artwork large, what it is and how it's
// being played, and beside that the lyrics, or what's coming next when there are none.
export component NowPlayingPage inherits Rectangle {
    property <bool> wide: self.width >= 760px;
    property <length> art: clamp(min(self.height - 250px, (self.wide ? self.width * 0.42 : self.width) - 96px), 140px, 520px);

    if !Player.has-track: Text {
        text: "Nothing is playing";
        color: Theme.muted;
        font-family: Theme.display;
        font-size: 24px;
        font-weight: 700;
    }

    if Player.has-track: HorizontalLayout {
        padding-left: 48px;
        padding-right: root.wide ? 0px : 48px;
        padding-top: 8px;
        padding-bottom: 24px;
        spacing: 24px;

        VerticalLayout {
            width: root.wide ? root.art : parent.width - 96px;
            alignment: center;
            spacing: 6px;

            HorizontalLayout {
                alignment: root.wide ? start : center;
                Rectangle {
                    width: root.art;
                    height: root.art;
                    border-radius: 10px;
                    background: Theme.raised;
                    drop-shadow-blur: 40px;
                    drop-shadow-offset-y: 10px;
                    drop-shadow-color: #00000090;
                    Cover {
                        art: Player.track.cover;
                        detail: 640px;
                    }
                }
            }

            Rectangle {
                height: 18px;
            }

            Text {
                text: Player.track.title;
                color: Theme.text;
                font-family: Theme.display;
                font-size: 30px;
                font-weight: 800;
                overflow: elide;
            }

            LinkText {
                text: Player.track.artist;
                font-size: 17px;
                enabled: Player.track.artist-id != "";
                clicked => {
                    View.card-activated({ kind: CardKind.artist, id: Player.track.artist-id, title: Player.track.artist });
                }
            }

            LinkText {
                text: Player.track.album;
                font-size: 15px;
                ink: Theme.faint;
                enabled: Player.track.album-id != "";
                clicked => {
                    View.card-activated({
                        kind: CardKind.album,
                        id: Player.track.album-id,
                        title: Player.track.album,
                        subtitle: Player.track.artist,
                        cover: Player.track.cover,
                    });
                }
            }

            Rectangle {
                height: 6px;
            }

            if Player.format != "": Text {
                text: Player.format;
                color: Player.lossless ? Theme.accent-bright : Theme.muted;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            if Settings.output-status != "": Text {
                text: "Output: " + Settings.output-status;
                color: Theme.faint;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        if root.wide: Rectangle {
            horizontal-stretch: 1;

            if Lyrics.lines.length > 0: LyricsPage { }

            if Lyrics.lines.length == 0: VerticalLayout {
                padding-left: 24px;
                padding-right: 32px;
                alignment: center;
                spacing: 4px;

                Text {
                    text: Player.queue.length == 0 ? "Nothing queued after this" : "Up next";
                    color: Theme.muted;
                    font-size: 13px;
                    font-weight: 600;
                    height: 32px;
                    vertical-alignment: center;
                }

                for track[index] in Player.queue: Rectangle {
                    // A glance at what's coming; the queue panel has the rest.
                    visible: index < 6;
                    height: index < 6 ? 60px : 0px;
                    border-radius: 6px;
                    background: next-touch.has-hover ? Theme.hover : transparent;

                    next-touch := TouchArea {
                        mouse-cursor: pointer;
                        double-clicked => { Player.queue-activated(index); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Cover {
                                width: 44px;
                                height: 44px;
                                art: track.cover;
                                detail: 48px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            Text {
                                text: track.title;
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: track.artist;
                                color: Theme.muted;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: track.duration;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    min-height: 56px;

    HorizontalLayout {
        spacing: 24px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component SettingGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 12px;

    Text {
        text: root.title;
        color: Theme.text;
        font-family: Theme.display;
        font-size: 20px;
        font-weight: 700;
        height: 36px;
        vertical-alignment: center;
    }

    @children
}

// A colour theme to pick: its surface colour with a dot of its accent, and its name.
component ThemeSwatch inherits Rectangle {
    in property <ThemeOption> option;
    in property <bool> selected;
    callback clicked;

    min-width: 76px;
    max-width: 124px;
    horizontal-stretch: 1;
    height: 84px;
    border-radius: 10px;
    background: self.option.surface;
    border-width: self.selected ? 2px : 1px;
    border-color: self.selected ? Theme.accent-bright : touch.has-hover ? Theme.muted : Theme.line;
    animate border-color { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.option.name + " theme";
    accessible-checkable: true;
    accessible-checked: self.selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        x: 14px;
        y: 14px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.option.accent;
    }

    Text {
        x: 14px;
        y: parent.height - self.height - 12px;
        text: root.option.name;
        color: white;
        font-size: 13px;
        font-weight: 600;
    }
}

// One choice in the streaming quality list.
component QualityRow inherits Rectangle {
    in property <QualityOption> option;
    in property <bool> selected;
    callback clicked;

    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.option.title;
    accessible-checkable: true;
    accessible-checked: self.selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;

            Text {
                text: root.option.title;
                color: root.selected ? Theme.accent-bright : Theme.text;
                font-size: 15px;
                font-weight: 600;
            }

            Text {
                text: root.option.detail;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.check;
                size: 18px;
                tint: Theme.accent-bright;
                opacity: root.selected ? 1 : 0;
            }
        }
    }
}

// The equaliser: six draggable points on a plus-or-minus 12 dB plot.
component EqPanel inherits Rectangle {
    property <length> side: 76px;
    property <length> plot-top: 76px;
    property <length> plot-height: 168px;
    property <length> step: (self.width - 2 * self.side) / 5;
    property <length> zero: self.plot-top + self.plot-height / 2;

    pure function px(band: int) -> float {
        return (root.side + band * root.step) / 1px;
    }
    pure function py(band: int) -> float {
        return (root.zero - Settings.eq-gains[band] / 12 * root.plot-height / 2) / 1px;
    }
    function gain-at(y: length) -> float {
        return clamp((root.zero - y) / (root.plot-height / 2) * 12, -12, 12);
    }

    property <string> curve: "M " + px(0) + " " + py(0) + " L " + px(1) + " " + py(1) + " L " + px(2) + " " + py(2)
        + " L " + px(3) + " " + py(3) + " L " + px(4) + " " + py(4) + " L " + px(5) + " " + py(5);
    property <float> floor: (self.plot-top + self.plot-height) / 1px;

    height: 308px;
    border-radius: 10px;
    background: Theme.raised;

    // Presets.
    Text {
        x: 24px;
        y: 24px;
        height: 32px;
        text: "Preset";
        color: Theme.muted;
        font-size: 14px;
        vertical-alignment: center;
    }

    preset := Rectangle {
        x: 84px;
        y: 24px;
        width: preset-row.preferred-width;
        height: 32px;
        border-radius: 16px;
        background: preset-touch.has-hover ? Theme.press : Theme.hover;
        accessible-role: button;
        accessible-label: "Equaliser preset: " + Settings.eq-preset;
        accessible-action-default => { preset-touch.clicked(); }

        preset-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Settings.choose-preset(preset.absolute-position.x, preset.absolute-position.y + preset.height + 4px); }
        }

        preset-row := HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 6px;
            Text {
                text: Settings.eq-preset;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.chevron-down;
                    size: 16px;
                }
            }
        }
    }

    // Scale.
    Text {
        x: 16px;
        y: root.plot-top - 8px;
        text: "+12 dB";
        color: Theme.faint;
        font-size: 12px;
    }

    Text {
        x: 16px;
        y: root.plot-top + root.plot-height - 8px;
        text: "−12 dB";
        color: Theme.faint;
        font-size: 12px;
    }

    Rectangle {
        x: root.side - 24px;
        y: root.zero;
        width: root.width - 2 * root.side + 48px;
        height: 1px;
        background: Theme.line;
    }

    // The curve and the area beneath it.
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.curve + " L " + px(5) + " " + root.floor + " L " + px(0) + " " + root.floor + " Z";
        fill: @linear-gradient(180deg, Theme.accent.with-alpha(0.55) 0%, Theme.accent.with-alpha(0.04) 100%);
        stroke-width: 0px;
    }

    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.curve;
        stroke: Theme.accent-bright;
        stroke-width: 2px;
    }

    for label[band] in Settings.eq-labels: Rectangle {
        x: root.side + band * root.step - root.step / 2;
        y: root.plot-top - 10px;
        width: root.step;
        height: root.plot-height + 52px;

        Rectangle {
            y: 10px;
            width: 1px;
            height: root.plot-height;
            background: Theme.line;
        }

        Rectangle {
            y: root.py(band) * 1px - parent.y - self.height / 2;
            width: drag.has-hover || drag.pressed ? 16px : 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: white;
            animate width { duration: 100ms; }
        }

        Text {
            y: root.plot-height + 24px;
            width: parent.width;
            text: label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        drag := TouchArea {
            height: root.plot-height + 20px;
            y: 0;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    Settings.set-eq-band(band, root.gain-at(parent.y + self.mouse-y), false);
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    Settings.set-eq-band(band, root.gain-at(parent.y + self.mouse-y), true);
                }
            }
            moved => {
                if self.pressed {
                    Settings.set-eq-band(band, root.gain-at(parent.y + self.mouse-y), false);
                }
            }
        }
    }

    TextButton {
        x: root.width - self.width - 20px;
        y: 23px;
        width: 88px;
        height: 34px;
        text: "Reset";
        clicked => { Settings.reset-eq(); }
    }
}

export component SettingsPage inherits Rectangle {
    scroll := ScrollView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        VerticalLayout {
            width: scroll.visible-width;
            alignment: start;

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    width: min(scroll.visible-width - 2 * Theme.page-pad, 760px);
                    alignment: start;
                    padding-top: 8px;
                    padding-bottom: 56px;
                    spacing: 28px;

                    Text {
                        text: "Settings";
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: 34px;
                        font-weight: 800;
                    }

                    SettingGroup {
                        title: "Appearance";

                        SettingRow {
                            title: "Theme";
                            detail: "Colours for the whole app, including the window's title bar.";
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            for option[index] in Settings.themes: ThemeSwatch {
                                option: option;
                                selected: index == Settings.theme;
                                clicked => { Settings.set-theme(index); }
                            }
                        }

                        SettingRow {
                            title: "Use the standard Windows title bar";
                            detail: "Puts back the title bar Windows draws, above the app's own top bar. Try this if the window is hard to move, resize or snap.";
                            Toggle {
                                on: Settings.standard-title-bar;
                                label: "Use the standard Windows title bar";
                                toggled(on) => { Settings.set-standard-title-bar(on); }
                            }
                        }

                        SettingRow {
                            title: "Interface size";
                            detail: "Makes text and controls larger or smaller. Applies the next time the app starts.";
                            HorizontalLayout {
                                spacing: 6px;
                                for name[index] in Settings.ui-scales: Chip {
                                    text: name;
                                    selected: index == Settings.ui-scale;
                                    clicked => { Settings.set-ui-scale(index); }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Audio quality";

                        Text {
                            text: "Lossless plays your files untouched. The other settings have your server convert to MP3 as you listen, which uses less data away from home.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        VerticalLayout {
                            spacing: 2px;
                            for option[index] in Settings.qualities: QualityRow {
                                option: option;
                                selected: index == Settings.quality;
                                clicked => { Settings.set-quality(index); }
                            }
                        }

                        if Settings.now-format != "": Text {
                            text: Settings.now-format;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    SettingGroup {
                        title: "Output";

                        SettingRow {
                            title: "Play through";
                            detail: Settings.output-status;
                            device := TextButton {
                                text: Settings.output-device;
                                max-width: 280px;
                                clicked => { Settings.choose-device(device.absolute-position.x, device.absolute-position.y + device.height + 4px); }
                            }
                        }

                        SettingRow {
                            title: "Exclusive mode";
                            detail: "Gives Nexus Music the device to itself and plays each song at its own sample rate, so nothing is resampled or mixed on the way out. Other apps are silent while music plays. For bit-perfect output, also keep the volume at full and leave the equaliser and volume levelling off.";
                            Toggle {
                                on: Settings.exclusive;
                                label: "Exclusive mode";
                                toggled(on) => { Settings.set-exclusive(on); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Playback";

                        SettingRow {
                            title: "Crossfade songs";
                            detail: "Blends the end of each song into the start of the next.";
                            HorizontalLayout {
                                spacing: 12px;
                                fade := Slider {
                                    width: 200px;
                                    value: Settings.crossfade / 12;
                                    label: "Crossfade length";
                                    moved(value) => { Settings.set-crossfade(value * 12, false); }
                                    released(value) => { Settings.set-crossfade(value * 12, true); }
                                }

                                Text {
                                    width: 36px;
                                    text: Settings.crossfade < 0.5 ? "Off" : Math.round(Settings.crossfade) + " s";
                                    color: Theme.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SettingRow {
                            title: "Gapless playback";
                            detail: "Runs one track straight into the next, the way live albums and mixes are meant to be heard.";
                            Toggle {
                                on: Settings.gapless;
                                label: "Gapless playback";
                                toggled(on) => { Settings.set-gapless(on); }
                            }
                        }

                        SettingRow {
                            title: "Autoplay";
                            detail: "When your queue ends, keeps going with similar music from your library.";
                            Toggle {
                                on: Settings.autoplay;
                                label: "Autoplay";
                                toggled(on) => { Settings.set-autoplay(on); }
                            }
                        }

                        SettingRow {
                            title: "Even out volume";
                            detail: "Uses the ReplayGain tags in your files so quiet and loud tracks play at a similar level.";
                            Toggle {
                                on: Settings.normalize;
                                label: "Even out volume";
                                toggled(on) => { Settings.set-normalize(on); }
                            }
                        }

                        if Settings.normalize: SettingRow {
                            title: "Volume level";
                            detail: "How loud that level is. Loud can round off the peaks of dynamic music; Normal and Quiet never do.";
                            HorizontalLayout {
                                spacing: 6px;
                                for name[index] in Settings.volume-levels: Chip {
                                    text: name;
                                    selected: index == Settings.volume-level;
                                    clicked => { Settings.set-volume-level(index); }
                                }
                            }
                        }

                        if Settings.normalize: SettingRow {
                            title: "Level by";
                            detail: "Song makes every song equally loud. Album keeps an album's quiet and loud songs in proportion. Auto uses Album while you play an album through, and Song otherwise.";
                            HorizontalLayout {
                                spacing: 6px;
                                for name[index] in Settings.level-modes: Chip {
                                    text: name;
                                    selected: index == Settings.level-mode;
                                    clicked => { Settings.set-level-mode(index); }
                                }
                            }
                        }

                        SettingRow {
                            title: "Mono audio";
                            detail: "Plays the same sound from the left and right speakers.";
                            Toggle {
                                on: Settings.mono;
                                label: "Mono audio";
                                toggled(on) => { Settings.set-mono(on); }
                            }
                        }

                        SettingRow {
                            title: "Equaliser";
                            detail: "Shapes the bass, mids and treble. Drag the points, or pick a preset.";
                            Toggle {
                                on: Settings.equalizer;
                                label: "Equaliser";
                                toggled(on) => { Settings.set-equalizer(on); }
                            }
                        }

                        if Settings.equalizer: EqPanel { }

                        SettingRow {
                            title: "Report plays to Navidrome";
                            detail: "Keeps play counts and Recently played up to date, and feeds Last.fm or ListenBrainz if you linked them in Navidrome.";
                            Toggle {
                                on: Settings.scrobble;
                                label: "Report plays to Navidrome";
                                toggled(on) => { Settings.set-scrobble(on); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Server";

                        SettingRow {
                            title: App.server;
                            detail: "Signed in as " + App.username + (App.server-version != "" ? ", Navidrome " + App.server-version : "") + (Settings.connection != "" ? ". " + Settings.connection : "");
                            TextButton {
                                text: "Sign out";
                                clicked => { App.sign-out(); }
                            }
                        }

                        SettingRow {
                            title: "Import playlists from Spotify";
                            detail: "Export your playlists from Spotify first: one CSV file each from a tool such as Exportify, or Playlist1.json from the data Spotify sends when you ask for it. Songs are matched to your library by title and artist, and the ones that aren't found are listed. Importing again later adds songs you've since added to your library.";
                            TextButton {
                                text: "Choose files";
                                clicked => { Settings.import-spotify(); }
                            }
                        }

                        SettingRow {
                            title: "Keep my devices in step";
                            detail: "Your queue, Recently played, pinned playlists, each list's shuffle and sort, the dates songs were added, and the theme follow you to Nexus Music on other devices signed in to this account. Kept on your server, in a playlist named “Nexus Music sync” that other apps will show; leave it be.";
                            Toggle {
                                on: Settings.sync;
                                label: "Keep my devices in step";
                                toggled(on) => { Settings.set-sync(on); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Requests";

                        SettingRow {
                            title: "Ask for albums that aren't in your library";
                            detail: "For people who run Lidarr beside their music server. Search results gain a “Not in your library” row; choosing an album there puts it on Lidarr's list, and a Requests page shows what's on its way. Whole albums only.";
                            Toggle {
                                on: Settings.requests;
                                label: "Ask for albums that aren't in your library";
                                toggled(on) => { Settings.set-requests(on); }
                            }
                        }

                        if Settings.requests: VerticalLayout {
                            spacing: 8px;
                            padding-top: 4px;

                            Text {
                                text: "Lidarr's address";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            lidarr-address := Field {
                                text: Settings.lidarr-address;
                                placeholder: "https://lidarr.example.org";
                                label: "Lidarr's address";
                            }

                            Text {
                                text: "API key";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            lidarr-key := Field {
                                input-type: InputType.password;
                                placeholder: Settings.lidarr-has-key ? "On file. Type a new one to replace it." : "In Lidarr: Settings, General, API Key";
                                label: "Lidarr API key";
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                padding-top: 4px;
                                alignment: start;

                                TextButton {
                                    text: "Save and check";
                                    clicked => {
                                        Settings.save-requests(lidarr-address.text, lidarr-key.text);
                                        lidarr-key.text = "";
                                    }
                                }

                                Text {
                                    text: Settings.requests-status;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Only once a sign-in has been found in front of Lidarr.
                            if Settings.lidarr-gate != "": VerticalLayout {
                                spacing: 8px;
                                padding-top: 8px;

                                Text {
                                    text: "Sign-in in front of Lidarr";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: Settings.lidarr-has-token
                                        ? (Settings.lidarr-signed-in != "" ? "Signed in as " + Settings.lidarr-signed-in : "Signed in") + " at " + Settings.lidarr-gate + ". Your password isn't kept: this PC holds a token from that sign-in, and signing out hands it back."
                                        : "Lidarr is behind the sign-in at " + Settings.lidarr-gate + ". Sign in there in your browser. Your password isn't typed into this app or kept by it.";
                                    color: Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    if !Settings.lidarr-has-token && !Settings.lidarr-signing-in: TextButton {
                                        text: "Sign in with browser";
                                        clicked => { Settings.sign-in-requests(); }
                                    }

                                    if Settings.lidarr-signing-in: TextButton {
                                        text: "Cancel";
                                        clicked => { Settings.cancel-sign-in(); }
                                    }

                                    if Settings.lidarr-has-token && !Settings.lidarr-signing-in: TextButton {
                                        text: "Sign out";
                                        clicked => { Settings.sign-out-requests(); }
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Window";

                        SettingRow {
                            title: "Keep playing when the window is closed";
                            detail: "Closing the window tucks Nexus Music into the notification area by the clock, where its icon brings it back or quits it.";
                            Toggle {
                                on: Settings.close-to-tray;
                                label: "Keep playing when the window is closed";
                                toggled(on) => { Settings.set-close-to-tray(on); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Storage";

                        SettingRow {
                            title: "Offline mode";
                            detail: "Plays only what's downloaded and doesn't contact your server. Likes, ratings and plays are kept and sent when you turn it off.";
                            Toggle {
                                on: Settings.offline;
                                label: "Offline mode";
                                toggled(on) => { Settings.set-offline(on); }
                            }
                        }

                        SettingRow {
                            title: "Download quality";
                            detail: "What new downloads are saved as. Lossless keeps each file exactly as it is on your server; the others save smaller MP3 copies.";
                            HorizontalLayout {
                                spacing: 6px;
                                for option[index] in Settings.qualities: Chip {
                                    text: option.title;
                                    selected: index == Settings.download-quality;
                                    clicked => { Settings.set-download-quality(index); }
                                }
                            }
                        }

                        SettingRow {
                            title: "Downloads";
                            detail: Settings.downloads-summary + ". Songs saved on this PC play without the server, and from disk even when it's reachable.";
                            TextButton {
                                text: "Remove all";
                                clicked => { Settings.remove-downloads(); }
                            }
                        }

                        SettingRow {
                            title: "Cache";
                            detail: Settings.cache-size + " of cover art and page data saved on this PC, so things you've seen before open instantly.";
                            TextButton {
                                text: "Clear cache";
                                clicked => { Settings.clear-cache(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "About";

                        SettingRow {
                            title: "Nexus Music " + App.app-version;
                            detail: Settings.update-status;
                            if Settings.update-version == "": TextButton {
                                text: "Check for updates";
                                clicked => { Settings.check-updates-now(); }
                            }
                            if Settings.update-version != "": TextButton {
                                primary: true;
                                enabled: !Settings.update-busy;
                                text: Settings.can-self-update ? "Update to " + Settings.update-version : "Get " + Settings.update-version;
                                clicked => { Settings.install-update(); }
                            }
                        }

                        SettingRow {
                            title: "Check for updates automatically";
                            detail: "Looks for a new version when the app opens and tells you when there is one. Nothing is installed until you choose to.";
                            Toggle {
                                on: Settings.check-updates;
                                label: "Check for updates automatically";
                                toggled(on) => { Settings.set-check-updates(on); }
                            }
                        }

                        Text {
                            text: "A native player for Navidrome. Fonts: Bricolage Grotesque and Hanken Grotesk (SIL Open Font License). Icons: Lucide (ISC License).";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: start;
                            AboutSlint {
                                width: 180px;
                            }
                        }
                    }
                }
            }
        }
    }

    ScrollThumb {
        x: parent.width - self.width;
        content-y <=> scroll.content-y;
        content-height: scroll.content-height;
        visible-height: scroll.visible-height;
    }
}

export component LoginPage inherits Rectangle {
    background: Theme.base;

    // A wash of the brand colour behind the form.
    Rectangle {
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.25) 0%, Theme.accent.with-alpha(0) 70%);
        width: 900px;
        height: 900px;
        y: -420px;
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 380px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: Theme.accent;
                        Icon {
                            source: Icons.bars;
                            size: 26px;
                            tint: white;
                        }
                    }
                }

                Text {
                    text: "Connect to your Navidrome server";
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 34px;
                    font-weight: 800;
                    wrap: word-wrap;
                }

                Text {
                    text: "Nexus Music streams straight from the music library you host.";
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: "Server address";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                server := Field {
                    text: App.server;
                    placeholder: "http://192.168.1.10:4533";
                    label: "Server address";
                    accepted => { user.focus(); }
                }

                Text {
                    text: "Username";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                user := Field {
                    text: App.username;
                    label: "Username";
                    accepted => { password.focus(); }
                }

                Text {
                    text: "Password";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                password := Field {
                    input-type: InputType.password;
                    label: "Password";
                    accepted => { App.sign-in(server.text, user.text, password.text); }
                }

                if App.login-error != "": Text {
                    text: App.login-error;
                    color: Theme.danger;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 4px;
                }

                TextButton {
                    text: App.login-busy ? "Connecting…" : "Connect";
                    primary: true;
                    enabled: !App.login-busy && server.text != "" && user.text != "" && password.text != "";
                    height: 46px;
                    clicked => { App.sign-in(server.text, user.text, password.text); }
                }

                Text {
                    text: "Your password is kept in Windows Credential Manager on this PC.";
                    color: Theme.faint;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
