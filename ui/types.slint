// Data passed between the Rust side and the interface.

export enum Page { home, search, tracklist, artist, grid, settings, lyrics, now-playing }

export enum CardKind { album, artist, playlist, genre, mix, request, outside-artist }

export struct Track {
    id: string,
    title: string,
    artist: string,
    artist-id: string,
    album: string,
    album-id: string,
    cover: string,
    duration: string,
    // When the song was added to the list it's shown in, e.g. "3 Mar 2025"; empty if unknown.
    added: string,
    number: string,
    starred: bool,
    // Non-empty on the first track of a disc: shown as a divider above the row.
    section: string,
    // How many disc headings come at or before this row.
    sections-before: int,
    // This row is the one playing (the same song elsewhere in the list isn't).
    playing: bool,
    // 0 to 1 while the song is being downloaded; -1 otherwise.
    progress: float,
    // A copy is saved on this PC.
    downloaded: bool,
    // Part of the current selection.
    selected: bool,
    // Can't be played right now: the app is offline and the song isn't downloaded.
    unavailable: bool,
}

export struct Card {
    kind: CardKind,
    id: string,
    title: string,
    subtitle: string,
    cover: string,
}

// A song that isn't in the library, which could be had by asking for the album it's on.
export struct Offer {
    // The album it's on, by Lidarr's name for it, and that album's title.
    album: string,
    album-title: string,
    title: string,
    artist: string,
    // The first artist credited, by Lidarr's name for them, and what they're called.
    artist-id: string,
    artist-name: string,
    // What to say about where it's from, e.g. "…Something to Be • 2005".
    about: string,
    cover: string,
    duration: string,
    // The album has already been asked for.
    requested: bool,
    // Set when it's a song the library has, offered for a playlist: the song's id. The album
    // and artist ids are then the library's, and `requested` means it's been added.
    song: string,
}

// A figure at the top of a page, e.g. "312" over "hours listened".
export struct Stat {
    value: string,
    label: string,
}

export struct Shelf {
    title: string,
    // Route opened by "Show all"; empty hides the link.
    route: string,
    // Show every card on as many rows as it takes, instead of one row.
    wrap: bool,
    cards: [Card],
}

export struct CardRow {
    cards: [Card],
}

export struct PlaylistRef {
    id: string,
    name: string,
    subtitle: string,
    cover: string,
    // Kept at the top of the list.
    pinned: bool,
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: image,
    separator: bool,
    danger: bool,
    submenu: bool,
}

// A colour theme offered in Settings, shown as a swatch.
export struct ThemeOption {
    name: string,
    accent: color,
    surface: color,
}

// Something offered under the search box while typing.
export struct Suggestion {
    // 0 an artist, 1 an album, 2 a song.
    kind: int,
    title: string,
    subtitle: string,
    cover: string,
    liked: bool,
}

export struct LyricLine {
    text: string,
    // Seconds from the start of the track; negative when the lyrics aren't timed.
    time: float,
}

// Cover art, loaded lazily by the Rust side. Bindings pass `rev` so they re-run when art arrives.
export global Covers {
    in property <int> rev;
    pure callback get(id: string, size: int, rev: int) -> image;
    pure callback tint(id: string, rev: int) -> color;
}

export global App {
    in property <bool> signed-in;
    in property <string> server;
    in property <string> username;
    // Set by the Nexus server's component when it is installed (src/nexus/): only then does
    // the window track the account for it.
    in property <bool> nexus-on;
    // Called once the account in use has changed (see `account` in app.slint), for what
    // follows the account without being told by the controller: the Nexus server's
    // component (src/nexus/).
    callback account-changed();
    in property <string> server-version;
    in property <string> app-version;
    // The sign-in screen (src/nexus/signin.rs): signing in is to the Nexus server, which
    // hands this PC its music sign-in. The address and email last used are put back in it.
    in property <string> nexus-address;
    in property <string> nexus-email;
    in-out property <string> login-error;
    in property <bool> login-busy;
    callback sign-in(address: string, email: string, password: string);
    // A first sign-in with the one-time code the admin gave, and the password chosen, typed
    // twice: one press.
    callback sign-in-code(address: string, code: string, password: string, again: string);
    // The Nexus server said to come back in this many seconds: the button waits, counting.
    in property <int> login-wait;
    // The sign-in form was closed with nothing sent.
    callback form-closed();
    // Moved each time the window goes (to the tray too): what was typed into the sign-in
    // form and not sent goes with it (W7c item 13).
    in property <int> form-wipe;
    callback sign-out();
    // Signed out of the Nexus server with the music still playing (its data was put back):
    // the Account tab offers the sign-in screen, which is then shown over the app.
    in property <bool> nexus-sign-in-wanted;
    in-out property <bool> show-sign-in;
    // The Nexus server's machine has not shown its first screen yet (src/nexus/signin.rs): the
    // window shows neither the sign-in form nor the player until it has.
    in property <bool> nexus-starting;
    // Signed in to the Nexus server, whatever the player holds (an account whose admin has
    // not set its music sign-in yet is signed in, with no music).
    in property <bool> nexus-signed-in;
    // A music login is held.
    in property <bool> nexus-plays;
    // What the Nexus server records, as it asks the person to be told (design 13.6): shown
    // whole, over the window, until the person presses OK (W7c item 10). Empty: none.
    in-out property <string> nexus-notice;
    callback notice-seen();
    // The music server refused the music sign-in (src/subsonic.rs): the component asks the
    // Nexus server for the current one.
    callback music-login-refused();

    in property <Page> page: Page.home;
    // The current route, e.g. "home" or "playlist:abc"; the sidebar highlights from it.
    in property <string> route;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback navigate(route: string);
    callback go-back();
    callback go-forward();
    callback refresh();
    // Ctrl+Z: take back the last change to a playlist.
    callback undo();

    in-out property <string> search-text;
    callback search(text: string);

    in property <[PlaylistRef]> playlists;
    callback new-playlist();
    // The + beside "Playlists" was clicked: offer to make one or import some.
    callback playlist-menu(x: length, y: length);

    // The route key of the list the queue is playing from, e.g. "playlist:abc"; empty if it
    // isn't from a list. Play buttons for that list pause and resume it.
    in property <string> playing-source;
    // Requests are switched on, so there's a page for them.
    in property <bool> requests;
    in property <bool> queue-open;
    // The queue is open over the page, in a window too narrow to have it beside the page.
    // (Kept apart from `queue-open`, which is remembered: a queue left open in a wide
    // window mustn't cover the page when the window is made narrow.)
    in-out property <bool> queue-over;
    // Progress of downloads under way, e.g. "Downloading 3 of 12"; empty when idle.
    in property <string> download-status;
    // The app draws its own title bar, so it needs its own minimise, maximise and close buttons.
    in property <bool> custom-frame;
    in property <bool> maximized;
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // Reports where the controls in the top bar are (everything else in it drags the window).
    callback titlebar-layout(height: length, nav-right: length, search-left: length, search-right: length, controls-left: length);

    // The server can't be reached, or offline mode is on: only downloads will play.
    in property <bool> offline;
    in property <string> offline-label;
    // A newer version has been published.
    in property <bool> update-available;
    callback set-queue-open(open: bool);
    // Which tab the queue panel shows: 0 the queue, 1 recently played.
    in-out property <int> queue-tab;
    // The arrow keys act on the queue panel instead of the page.
    in-out property <bool> keys-in-queue;
    // Bumped to move keyboard focus into the search box.
    in-out property <int> search-focus;
    // Bumped to move keyboard focus out of the search box, back to the window's shortcuts.
    in property <int> main-focus;
}

// The preview of results shown under the search box as you type.
export global Search {
    in property <[Suggestion]> items;
    in-out property <bool> open;
    // The row picked out with the arrow keys; -1 for none.
    in-out property <int> highlight: -1;
    callback preview(text: string);
    callback activate(index: int);
    // Right-clicked: the same menu the item has anywhere else.
    callback menu(index: int, x: length, y: length);
}

// The page currently shown in the main panel.
export global View {
    in property <bool> loading;
    in property <string> error;
    // The header is drawn from what was clicked; the rest of the page is still loading.
    in property <bool> pending;

    in property <string> label;
    in property <string> title;
    in property <string> subtitle;
    // Where the subtitle links to, e.g. the album's artist; empty for plain text.
    in property <string> subtitle-route;
    in property <string> meta;
    // Something that went wrong on this page and what can be done about it, such as
    // downloads that failed and "Retry failed". Empty for nothing.
    in property <string> notice;
    in property <string> notice-action;
    callback notice-acted();
    // A second thing that can be done about it.
    in property <string> notice-other;
    callback notice-other-acted();
    // Figures shown across the top of the page.
    in property <[Stat]> stats;
    in property <string> about;
    in property <string> cover;
    in property <bool> cover-round;
    in property <bool> can-star;
    in property <bool> starred;
    in property <bool> can-play;
    in property <bool> has-menu;
    in property <bool> liked-songs;

    in property <[Track]> tracks;
    // How many disc headings the song list has in all.
    in property <int> track-sections;
    in property <string> tracks-title;
    in property <bool> show-album;
    in property <bool> show-cover;
    in property <bool> show-number;

    in property <[Shelf]> shelves;
    // Shelves shown above the songs instead of below them.
    in property <[Shelf]> lead;
    // A button beside the page's title, if it has something to offer; and it being clicked.
    in property <string> action;
    callback action-clicked();
    // Music that isn't in the library: a heading for the section, songs that could be asked
    // for, and shelves that go beneath them.
    in property <string> offers-title;
    // That section goes at the top of the page (what couldn't be asked for), not the foot.
    in property <bool> offers-first;
    // What the songs that could be asked for are headed; "Songs" if it's empty.
    in property <string> offers-heading;
    in property <string> offers-note;
    // Where "Show all" leads for the songs, and for the songs that aren't in the library;
    // empty when the whole list is already shown.
    in property <string> tracks-route;
    in property <string> offers-route;
    // On a search: the kinds it can be narrowed to, and which is chosen.
    in property <[string]> kinds;
    in property <int> kind;
    callback set-kind(index: int);
    // Finer choices under the chosen kind ("Your stats" has them under "All time").
    in property <[string]> sub-kinds;
    in property <int> sub-kind;
    callback set-sub-kind(index: int);
    in property <[Offer]> offers;
    in property <[Shelf]> tail;
    callback offer-activated(index: int);
    callback offer-request(index: int);
    // Asks for a different set of suggestions.
    callback offers-refresh();
    in property <[Card]> tiles;
    // Shown when the page has nothing to list.
    in property <string> empty;
    in property <[CardRow]> grid;
    in property <[string]> sorts;
    in property <int> sort;

    // Playlists and Liked songs can be filtered and sorted in place.
    in property <bool> can-filter;
    in-out property <string> filter;
    in property <string> track-sort;
    in property <bool> track-sort-custom;
    in property <bool> track-sort-descending;
    // Which column the songs are sorted by: 0 none (the list's own order), 1 title, 2 artist,
    // 3 album, 4 length, 5 date added.
    in property <int> track-sort-index;
    // The list has a "Date added" column.
    in property <bool> show-added;
    // This list plays shuffled.
    in property <bool> shuffle;
    // The queue is playing from this page's list, so its play button pauses and resumes.
    in property <bool> playing-here;
    // The page's songs can be saved on this PC. State: 0 none saved, 1 in progress, 2 all saved.
    in property <bool> can-download;
    in property <int> download-state;
    // While downloading: how many of the page's songs are saved, out of how many, and how
    // far along that is from 0 to 1 (counting the song in progress).
    in property <int> download-done;
    in property <int> download-total;
    in property <float> download-progress;
    // How many song rows are selected.
    in property <int> selection-count;
    // Rows can be dragged into a new order: a playlist shown in its own order, unfiltered.
    in property <bool> can-reorder;

    in-out property <length> scroll-y;

    callback play();
    callback toggle-shuffle();
    // A column heading was clicked.
    callback sort-column(column: int);
    callback toggle-star();
    callback header-menu(x: length, y: length);
    callback track-activated(index: int);
    callback track-star(index: int);
    callback track-menu(index: int, x: length, y: length);
    callback track-moved(index: int, delta: int);
    // A row was clicked, with Ctrl or Shift held to build up a selection.
    callback track-clicked(index: int, ctrl: bool, shift: bool);
    // The row at `index` (with the rest of the selection, if it's part of one) was dragged
    // onto `target`: "queue" or "playlist:<id>".
    callback rows-dropped(index: int, target: string);
    callback select-all();
    callback clear-selection();
    // Keyboard: move the selection by this many rows (extending it with Shift held), play
    // what's selected, take it out of the playlist. `cursor-row` is the row the keyboard is
    // on (-1 for none) and `reveal-tick` changes when that row should be scrolled into view.
    in property <int> cursor-row: -1;
    in property <int> reveal-tick;
    callback move-selection(delta: int, extend: bool);
    callback activate-selection();
    callback remove-selection();
    callback download();
    callback set-filter(text: string);
    callback choose-track-sort(x: length, y: length);
    callback card-activated(card: Card);
    // The pointer has rested on something that opens a page: a cue to fetch it early.
    callback card-hovered(card: Card);
    callback card-play(card: Card);
    callback card-menu(card: Card, x: length, y: length);
    callback set-sort(index: int);
    callback columns-changed(columns: int);
    callback near-end();
}

// Songs being dragged towards a playlist or the queue. Rows publish the pointer's position
// here; places that accept a drop watch it and name themselves as the target.
export global Drag {
    in-out property <bool> active;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <string> label;
    in-out property <string> target;
}

export global Player {
    in property <bool> has-track;
    in property <Track> track;
    in property <string> track-id;
    in property <bool> playing;
    in property <bool> buffering;
    // The song's stream stopped arriving and is being asked for again.
    in property <bool> reconnecting;
    // The song is meant to be playing but is waiting for more of its stream.
    in property <bool> stalled;
    in property <float> position;
    in property <float> duration;
    in property <float> volume: 1;
    in property <bool> muted;
    in property <bool> shuffle;
    // 0 off, 1 repeat the queue, 2 repeat the track.
    in property <int> repeat;
    // What's to come. The first `queued` rows were queued by hand ("Next in queue"); the
    // rest are what's left of the list being played. Where both are present, the row at
    // `queue-gap` holds no song: it's the heading between them. -1 when there's no heading.
    in property <[Track]> queue;
    in property <int> queued;
    in property <int> queue-gap: -1;
    // The first few of `queue`, for places that only show a glance of it.
    in property <[Track]> up-next;
    in property <string> context;
    // The current song's audio format in a few words, e.g. "FLAC · 44.1 kHz · 16-bit".
    in property <string> format;
    in property <bool> lossless;
    // Songs played before the current one, newest first.
    in property <[Track]> history;
    // What the sleep timer is set to, in words; empty when it's off.
    in property <string> sleep;

    callback toggle();
    callback next();
    callback previous();
    callback seek(seconds: float);
    callback set-volume(volume: float);
    callback toggle-mute();
    // Jump forwards or back by this many seconds.
    callback seek-by(seconds: float);
    // The row of the queue panel the keyboard is on, -1 for none.
    in-out property <int> queue-cursor: -1;
    callback queue-remove(index: int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-star();
    // Swaps the window for the small one that stays on top of other apps.
    callback open-mini();
    callback queue-activated(index: int);
    callback queue-menu(index: int, x: length, y: length);
    // Empties "Next in queue" (`queued`) or the rest of what's to come.
    callback clear-queue(queued: bool);
    callback save-queue();
    // What another device is playing ("Song — Artist"), when that's more recent than
    // anything done here; empty otherwise.
    in property <string> elsewhere;
    callback continue-here();
    callback choose-sleep(x: length, y: length);
    // The queue row at `index` was dragged `delta` places down (or up, when negative).
    callback queue-moved(index: int, delta: int);
    callback history-activated(index: int);
    callback history-menu(index: int, x: length, y: length);

    pure public function clock(seconds: float) -> string {
        return floor(seconds / 60) + ":" + (Math.mod(floor(seconds), 60) < 10 ? "0" : "") + Math.mod(floor(seconds), 60);
    }
}

export global Menu {
    in property <bool> open;
    in property <length> x;
    in property <length> y;
    in property <string> title;
    in property <[MenuEntry]> entries;
    // The entry the keyboard is on (-1 for none) and how far down the menu it is.
    in-out property <int> cursor: -1;
    in property <length> cursor-y;
    callback move(delta: int);
    callback accept();
    callback activated(id: string);
    callback dismissed();
}

export global Prompt {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label;
    // The other button: usually "Cancel", sometimes a second answer.
    in property <string> cancel-label: "Cancel";
    in property <bool> wants-text;
    in property <bool> danger;
    in-out property <string> text;
    callback confirmed(text: string);
    callback cancelled();
    // Closed without pressing either button.
    callback dismissed();
}

export global Toast {
    in property <bool> visible;
    in property <string> text;
    // Something that can be done about what the toast says ("Undo"); empty for nothing.
    in property <string> action;
    callback acted();
}

export global Lyrics {
    in property <[LyricLine]> lines;
    in property <bool> timed;
    in property <int> active: -1;
    // What to say when there are no lines to show, and a line of explanation beneath it.
    in property <string> status;
    in property <string> note;
}

// One of the person's devices, in the list under Settings, Account.
export struct DeviceRow {
    id: string,
    name: string,
    detail: string,
    here: bool,
    can-force-out: bool,
}

export struct QualityOption {
    title: string,
    detail: string,
}

export global Settings {
    // Whether there is a Nexus server at the music server's address: empty until it has been
    // looked for, then what was found, for the account in `nexus-for` (the server and the
    // name, on two lines). Shown only while that account is the one signed in. Set by
    // src/nexus.rs alone.
    in property <string> nexus-server;
    in property <string> nexus-for;
    // The Nexus server, as its client says (src/nexus/signin.rs): the row ("Connected",
    // "Not reachable since 14:02. Your music plays as usual"), who is signed in, and a
    // sentence about the music sign-in when there is one.
    in property <string> nexus-row;
    in property <string> nexus-who;
    in property <string> nexus-music;
    // The person's devices, and forcing one out.
    in property <[DeviceRow]> devices;
    in property <bool> devices-busy;
    in property <string> devices-note;
    callback load-devices();
    callback force-out(id: string);
    // Changing the password.
    in property <bool> password-busy;
    in property <bool> password-changed;
    in property <string> password-note;
    callback change-password(current: string, new: string, again: string);
    in property <[QualityOption]> qualities;
    // Their names alone, for the control that chooses between them.
    in property <[string]> quality-names;
    // Which section of the settings is showing.
    in-out property <int> tab;
    in property <int> quality;
    // What the current song is and how it's being streamed.
    in property <string> now-format;

    // Seconds of overlap between tracks; 0 is off.
    in property <float> crossfade;
    in property <bool> gapless;
    in property <bool> autoplay;
    in property <bool> normalize;
    in property <[string]> volume-levels;
    in property <int> volume-level;
    in property <[string]> level-modes;
    // How much songs with no levelling tags are turned down.
    in property <[string]> untagged-levels;
    in property <int> untagged-level;
    callback set-untagged-level(index: int);
    // The equaliser's preamp: Auto, Off, or a set amount.
    in property <[string]> preamps;
    in property <int> preamp;
    callback set-preamp(index: int);
    in property <int> level-mode;
    in property <bool> mono;
    in property <bool> scrobble;

    in property <bool> equalizer;
    // Gain in dB for each band, -12 to 12.
    in property <[float]> eq-gains;
    in property <[string]> eq-labels;
    in property <string> eq-preset;

    in property <string> downloads-summary;
    // Where downloads are kept, and whether that's somewhere other than the app's own folder.
    in property <string> downloads-folder;
    in property <bool> downloads-folder-custom;
    callback change-downloads-folder();
    callback reset-downloads-folder();
    // The same for the songs kept as they play.
    in property <string> songs-folder;
    in property <bool> songs-folder-custom;
    callback change-songs-folder();
    callback reset-songs-folder();
    // Which of `qualities` downloads are saved in.
    in property <int> download-quality;
    // Offline mode is switched on.
    in property <bool> offline;
    in property <string> cache-size;
    // Songs kept as they're played: how much space they may take (the choices and which is
    // chosen; the first keeps none), how many are fetched ahead, and how much is kept now.
    in property <[string]> cache-limits;
    in property <int> cache-limit;
    in property <[string]> cache-aheads;
    in property <int> cache-ahead;
    in property <string> kept-songs;
    callback set-cache-limit(index: int);
    callback set-cache-ahead(index: int);
    in property <string> connection;

    // The chosen output device's name, and how it's being driven right now.
    in property <string> output-device;
    in property <string> output-status;
    in property <bool> exclusive;

    // Use Windows' own title bar instead of the built-in one.
    in property <bool> standard-title-bar;
    in property <[ThemeOption]> themes;
    in property <int> theme;
    in property <[string]> ui-scales;
    in property <int> ui-scale;

    in property <bool> close-to-tray;
    in property <bool> check-updates;
    // Share the queue, pins and so on with the app on other devices.
    in property <bool> sync;
    // What is wrong, when this PC isn't sharing as it should (its clock, say); else empty.
    in property <string> sync-note;
    // What the last check for a new version found, in words.
    in property <string> update-status;
    // The newer version on offer; empty when there is none.
    in property <string> update-version;
    in property <bool> update-busy;
    in property <bool> update-download-failed;
    // This copy was installed, so it can replace itself. A portable copy opens the download page.
    in property <bool> can-self-update;

    callback set-quality(index: int);
    // `save` is false while a slider is being dragged and true when it's let go.
    callback set-crossfade(seconds: float, save: bool);
    callback set-gapless(on: bool);
    callback set-autoplay(on: bool);
    callback set-normalize(on: bool);
    callback set-volume-level(level: int);
    callback set-level-mode(mode: int);
    callback set-mono(on: bool);
    callback set-scrobble(on: bool);
    callback set-equalizer(on: bool);
    callback set-eq-band(band: int, gain: float, save: bool);
    callback reset-eq();
    callback choose-preset(x: length, y: length);
    callback clear-cache();
    callback remove-downloads();
    callback set-download-quality(index: int);
    callback set-offline(on: bool);
    callback choose-device(x: length, y: length);
    callback set-exclusive(on: bool);
    callback set-standard-title-bar(on: bool);
    callback set-theme(index: int);
    callback set-ui-scale(index: int);
    callback set-close-to-tray(on: bool);
    callback set-check-updates(on: bool);
    callback set-sync(on: bool);
    callback import-spotify();
    // Asking a Lidarr server for albums that aren't in the library.
    in property <bool> requests;
    // Singles and EPs are offered as well as albums.
    in property <bool> request-singles;
    callback set-request-singles(on: bool);
    in property <string> lidarr-address;
    // The API key on file, as dots and its last few characters; empty if there's none.
    in property <string> lidarr-key-hint;
    // The sign-in service in front of Lidarr, if one was found ("auth.example.org"); whether
    // this PC is signed in to it, and as whom.
    in property <string> lidarr-gate;
    in property <bool> lidarr-has-token;
    // A token is kept that isn't used: for a sign-in service that's refused (see
    // `gate::not_trusted`). Signing out clears it, sending it nowhere.
    in property <bool> lidarr-token-unused;
    in property <string> lidarr-signed-in;
    // Where the connection stands: "none", "checking", "connected", "sign-in" (a sign-in is
    // needed), "waiting" (on the browser) or "error"; and the same in words.
    in property <string> requests-state: "none";
    in property <string> requests-status;
    callback set-requests(on: bool);
    // Saves the address and key and connects, going on to the sign-in if one is needed.
    callback save-requests(address: string, key: string);
    callback check-requests();
    callback sign-in-requests();
    callback cancel-sign-in();
    callback sign-out-requests();
    // What this PC is called in the person's list of devices at the Nexus server.
    in property <string> device-name;
    callback set-device-name(name: string);
    callback check-updates-now();
    in property <bool> nexus-records-listening;
    in property <bool> send-diagnostics: true;
    in property <string> diagnostics-detail;
    callback set-send-diagnostics(on: bool);
    callback save-diagnostics();
    callback preview-diagnostics();
    in-out property <string> diagnostics-preview;
    callback install-update();
}
