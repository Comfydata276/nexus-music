// Data passed between the Rust side and the interface.

export enum Page { home, search, tracklist, artist, grid, settings, lyrics, now-playing }

export enum CardKind { album, artist, playlist, genre }

export struct Track {
    id: string,
    title: string,
    artist: string,
    artist-id: string,
    album: string,
    album-id: string,
    cover: string,
    duration: string,
    number: string,
    starred: bool,
    // Non-empty on the first track of a disc: shown as a divider above the row.
    section: string,
    // How many disc headings come at or before this row.
    sections-before: int,
    // This row is the one playing (the same song elsewhere in the list isn't).
    playing: bool,
    // 0 to 1 while the song is being downloaded; -1 otherwise.
    progress: float,
    // A copy is saved on this PC.
    downloaded: bool,
    // Part of the current selection.
    selected: bool,
    // Can't be played right now: the app is offline and the song isn't downloaded.
    unavailable: bool,
}

export struct Card {
    kind: CardKind,
    id: string,
    title: string,
    subtitle: string,
    cover: string,
}

export struct Shelf {
    title: string,
    // Route opened by "Show all"; empty hides the link.
    route: string,
    // Show every card on as many rows as it takes, instead of one row.
    wrap: bool,
    cards: [Card],
}

export struct CardRow {
    cards: [Card],
}

export struct PlaylistRef {
    id: string,
    name: string,
    subtitle: string,
    cover: string,
    // Kept at the top of the list.
    pinned: bool,
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: image,
    separator: bool,
    danger: bool,
    submenu: bool,
}

// A colour theme offered in Settings, shown as a swatch.
export struct ThemeOption {
    name: string,
    accent: color,
    surface: color,
}

export struct LyricLine {
    text: string,
    // Seconds from the start of the track; negative when the lyrics aren't timed.
    time: float,
}

// Cover art, loaded lazily by the Rust side. Bindings pass `rev` so they re-run when art arrives.
export global Covers {
    in property <int> rev;
    pure callback get(id: string, size: int, rev: int) -> image;
    pure callback tint(id: string, rev: int) -> color;
}

export global App {
    in property <bool> signed-in;
    in property <string> server;
    in property <string> username;
    in property <string> server-version;
    in property <string> app-version;
    in property <string> login-error;
    in property <bool> login-busy;
    callback sign-in(server: string, username: string, password: string);
    callback sign-out();

    in property <Page> page: Page.home;
    // The current route, e.g. "home" or "playlist:abc"; the sidebar highlights from it.
    in property <string> route;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback navigate(route: string);
    callback go-back();
    callback go-forward();
    callback refresh();

    in-out property <string> search-text;
    callback search(text: string);

    in property <[PlaylistRef]> playlists;
    callback new-playlist();

    in property <bool> queue-open;
    // Progress of downloads under way, e.g. "Downloading 3 of 12"; empty when idle.
    in property <string> download-status;
    // The app draws its own title bar, so it needs its own minimise, maximise and close buttons.
    in property <bool> custom-frame;
    in property <bool> maximized;
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // Reports where the controls in the top bar are (everything else in it drags the window).
    callback titlebar-layout(height: length, nav-right: length, search-left: length, search-right: length, controls-left: length);

    // The server can't be reached, or offline mode is on: only downloads will play.
    in property <bool> offline;
    in property <string> offline-label;
    // A newer version has been published.
    in property <bool> update-available;
    callback set-queue-open(open: bool);
    // Which tab the queue panel shows: 0 the queue, 1 recently played.
    in-out property <int> queue-tab;
    // Bumped to move keyboard focus into the search box.
    in-out property <int> search-focus;
    // Bumped to move keyboard focus out of the search box, back to the window's shortcuts.
    in property <int> main-focus;
}

// The page currently shown in the main panel.
export global View {
    in property <bool> loading;
    in property <string> error;
    // The header is drawn from what was clicked; the rest of the page is still loading.
    in property <bool> pending;

    in property <string> label;
    in property <string> title;
    in property <string> subtitle;
    // Where the subtitle links to, e.g. the album's artist; empty for plain text.
    in property <string> subtitle-route;
    in property <string> meta;
    in property <string> about;
    in property <string> cover;
    in property <bool> cover-round;
    in property <bool> can-star;
    in property <bool> starred;
    in property <bool> can-play;
    in property <bool> has-menu;
    in property <bool> liked-songs;

    in property <[Track]> tracks;
    // How many disc headings the song list has in all.
    in property <int> track-sections;
    in property <string> tracks-title;
    in property <bool> show-album;
    in property <bool> show-cover;
    in property <bool> show-number;

    in property <[Shelf]> shelves;
    in property <[Card]> tiles;
    // Shown when the page has nothing to list.
    in property <string> empty;
    in property <[CardRow]> grid;
    in property <[string]> sorts;
    in property <int> sort;

    // Playlists and Liked songs can be filtered and sorted in place.
    in property <bool> can-filter;
    in-out property <string> filter;
    in property <string> track-sort;
    in property <bool> track-sort-custom;
    in property <bool> track-sort-descending;
    // The page's songs can be saved on this PC. State: 0 none saved, 1 in progress, 2 all saved.
    in property <bool> can-download;
    in property <int> download-state;
    // While downloading: how many of the page's songs are saved, out of how many, and how
    // far along that is from 0 to 1 (counting the song in progress).
    in property <int> download-done;
    in property <int> download-total;
    in property <float> download-progress;
    // How many song rows are selected.
    in property <int> selection-count;
    // Rows can be dragged into a new order: a playlist shown in its own order, unfiltered.
    in property <bool> can-reorder;

    in-out property <length> scroll-y;

    callback play(shuffle: bool);
    callback toggle-star();
    callback header-menu(x: length, y: length);
    callback track-activated(index: int);
    callback track-star(index: int);
    callback track-menu(index: int, x: length, y: length);
    callback track-moved(index: int, delta: int);
    // A row was clicked, with Ctrl or Shift held to build up a selection.
    callback track-clicked(index: int, ctrl: bool, shift: bool);
    // The row at `index` (with the rest of the selection, if it's part of one) was dragged
    // onto `target`: "queue" or "playlist:<id>".
    callback rows-dropped(index: int, target: string);
    callback select-all();
    callback clear-selection();
    callback download();
    callback set-filter(text: string);
    callback choose-track-sort(x: length, y: length);
    callback card-activated(card: Card);
    // The pointer has rested on something that opens a page: a cue to fetch it early.
    callback card-hovered(card: Card);
    callback card-play(card: Card);
    callback card-menu(card: Card, x: length, y: length);
    callback set-sort(index: int);
    callback columns-changed(columns: int);
    callback near-end();
}

// Songs being dragged towards a playlist or the queue. Rows publish the pointer's position
// here; places that accept a drop watch it and name themselves as the target.
export global Drag {
    in-out property <bool> active;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <string> label;
    in-out property <string> target;
}

export global Player {
    in property <bool> has-track;
    in property <Track> track;
    in property <string> track-id;
    in property <bool> playing;
    in property <bool> buffering;
    in property <float> position;
    in property <float> duration;
    in property <float> volume: 1;
    in property <bool> muted;
    in property <bool> shuffle;
    // 0 off, 1 repeat the queue, 2 repeat the track.
    in property <int> repeat;
    in property <[Track]> queue;
    in property <string> context;
    // The current song's audio format in a few words, e.g. "FLAC · 44.1 kHz · 16-bit".
    in property <string> format;
    in property <bool> lossless;
    // Songs played before the current one, newest first.
    in property <[Track]> history;
    // What the sleep timer is set to, in words; empty when it's off.
    in property <string> sleep;

    callback toggle();
    callback next();
    callback previous();
    callback seek(seconds: float);
    callback set-volume(volume: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-star();
    callback queue-activated(index: int);
    callback queue-menu(index: int, x: length, y: length);
    callback clear-queue();
    callback choose-sleep(x: length, y: length);
    // The queue row at `index` was dragged `delta` places down (or up, when negative).
    callback queue-moved(index: int, delta: int);
    callback history-activated(index: int);
    callback history-menu(index: int, x: length, y: length);

    pure public function clock(seconds: float) -> string {
        return floor(seconds / 60) + ":" + (Math.mod(floor(seconds), 60) < 10 ? "0" : "") + Math.mod(floor(seconds), 60);
    }
}

export global Menu {
    in property <bool> open;
    in property <length> x;
    in property <length> y;
    in property <string> title;
    in property <[MenuEntry]> entries;
    callback activated(id: string);
    callback dismissed();
}

export global Prompt {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label;
    // The other button: usually "Cancel", sometimes a second answer.
    in property <string> cancel-label: "Cancel";
    in property <bool> wants-text;
    in property <bool> danger;
    in-out property <string> text;
    callback confirmed(text: string);
    callback cancelled();
    // Closed without pressing either button.
    callback dismissed();
}

export global Toast {
    in property <bool> visible;
    in property <string> text;
}

export global Lyrics {
    in property <[LyricLine]> lines;
    in property <bool> timed;
    in property <int> active: -1;
    in property <string> status;
}

export struct QualityOption {
    title: string,
    detail: string,
}

export global Settings {
    in property <[QualityOption]> qualities;
    in property <int> quality;
    // What the current song is and how it's being streamed.
    in property <string> now-format;

    // Seconds of overlap between tracks; 0 is off.
    in property <float> crossfade;
    in property <bool> gapless;
    in property <bool> autoplay;
    in property <bool> normalize;
    in property <[string]> volume-levels;
    in property <int> volume-level;
    in property <[string]> level-modes;
    in property <int> level-mode;
    in property <bool> mono;
    in property <bool> scrobble;

    in property <bool> equalizer;
    // Gain in dB for each band, -12 to 12.
    in property <[float]> eq-gains;
    in property <[string]> eq-labels;
    in property <string> eq-preset;

    in property <string> downloads-summary;
    // Which of `qualities` downloads are saved in.
    in property <int> download-quality;
    // Offline mode is switched on.
    in property <bool> offline;
    in property <string> cache-size;
    in property <string> connection;

    // The chosen output device's name, and how it's being driven right now.
    in property <string> output-device;
    in property <string> output-status;
    in property <bool> exclusive;

    // Use Windows' own title bar instead of the built-in one.
    in property <bool> standard-title-bar;
    in property <[ThemeOption]> themes;
    in property <int> theme;
    in property <[string]> ui-scales;
    in property <int> ui-scale;

    in property <bool> close-to-tray;
    in property <bool> check-updates;
    // What the last check for a new version found, in words.
    in property <string> update-status;
    // The newer version on offer; empty when there is none.
    in property <string> update-version;
    in property <bool> update-busy;
    // This copy was installed, so it can replace itself. A portable copy opens the download page.
    in property <bool> can-self-update;

    callback set-quality(index: int);
    // `save` is false while a slider is being dragged and true when it's let go.
    callback set-crossfade(seconds: float, save: bool);
    callback set-gapless(on: bool);
    callback set-autoplay(on: bool);
    callback set-normalize(on: bool);
    callback set-volume-level(level: int);
    callback set-level-mode(mode: int);
    callback set-mono(on: bool);
    callback set-scrobble(on: bool);
    callback set-equalizer(on: bool);
    callback set-eq-band(band: int, gain: float, save: bool);
    callback reset-eq();
    callback choose-preset(x: length, y: length);
    callback clear-cache();
    callback remove-downloads();
    callback set-download-quality(index: int);
    callback set-offline(on: bool);
    callback choose-device(x: length, y: length);
    callback set-exclusive(on: bool);
    callback set-standard-title-bar(on: bool);
    callback set-theme(index: int);
    callback set-ui-scale(index: int);
    callback set-close-to-tray(on: bool);
    callback set-check-updates(on: bool);
    callback check-updates-now();
    callback install-update();
}
