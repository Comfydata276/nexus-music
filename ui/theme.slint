// Colour, type and spacing tokens. Everything visual reads from here. The colours are set
// from the chosen theme when the app starts (see `THEMES` in src/config.rs); the values below
// are the default, Violet.
export global Theme {
    // Surfaces, darkest to lightest. A plum-tinted ink, not neutral grey.
    in-out property <color> base: #0b0811;
    in-out property <color> panel: #14101d;
    in-out property <color> raised: #1e182b;
    in-out property <color> overlay: #251e35;
    out property <color> hover: #ffffff10;
    out property <color> press: #ffffff1c;
    out property <color> line: #ffffff16;

    in-out property <color> text: #f3effa;
    in-out property <color> muted: #a89fbb;
    in-out property <color> faint: #6f6783;

    // Violet from the app mark; amber marks what you've liked.
    in-out property <color> accent: #8b5cf6;
    in-out property <color> accent-bright: #a98bfb;
    in-out property <color> on-accent: #150c2b;
    in-out property <color> warm: #f5b85c;
    out property <color> danger: #f47676;

    out property <string> display: "Bricolage Grotesque";

    out property <length> radius: 10px;
    out property <length> gap: 8px;
    out property <length> page-pad: 24px;
}
