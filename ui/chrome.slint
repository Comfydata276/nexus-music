// The parts of the window that stay put: library sidebar, top bar, queue and the player bar.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Player, View, CardKind, PlaylistRef, Page, Track, Drag, Search, Suggestion, Jam, Devices, Linked } from "types.slint";
import { Icon, IconButton, Cover, Slider, LinkText, PlayButton, HoverIntent, ScrollThumb, Reorder, TextButton } from "widgets.slint";
import { DeviceRow } from "overlays.slint";

// Rows stop `gutter` short of a list's right edge, leaving the scrollbar a lane of its own.
// The lists run `reach` into the panel's padding so that lane sits at the panel's edge.
global Lane {
    out property <length> gutter: 14px;
    out property <length> reach: 8px;
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    // Something is going on behind it (a jam is running): drawn in the accent colour.
    in property <bool> lit;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    background: self.selected ? Theme.hover : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 20px;
                tint: root.lit ? Theme.accent-bright : root.selected || touch.has-hover ? Theme.text : Theme.muted;
            }
        }

        Text {
            text: root.text;
            color: root.lit ? Theme.accent-bright : root.selected || touch.has-hover ? Theme.text : Theme.muted;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PlaylistItem inherits Rectangle {
    in property <PlaylistRef> playlist;
    // This playlist is what's playing right now.
    property <bool> playing: Player.playing && App.playing-source == "playlist:" + self.playlist.id;
    in property <bool> selected;
    callback clicked;
    callback play;
    callback rested;
    callback menu(x: length, y: length);

    // Songs being dragged are over this playlist.
    property <bool> drop-here: Drag.active
        && Drag.x >= self.absolute-position.x && Drag.x < self.absolute-position.x + self.width
        && Drag.y >= self.absolute-position.y && Drag.y < self.absolute-position.y + self.height;
    changed drop-here => {
        if self.drop-here {
            Drag.target = "playlist:" + self.playlist.id;
        } else if Drag.target == "playlist:" + self.playlist.id {
            Drag.target = "";
        }
    }

    height: 56px;
    border-radius: 6px;
    background: self.drop-here ? Theme.accent.with-alpha(0.28) : self.selected ? Theme.hover : touch.has-hover ? Theme.hover : transparent;

    HoverIntent {
        hovered: touch.has-hover;
        rested => { root.rested(); }
    }

    accessible-role: button;
    accessible-label: self.playlist.name;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;

                art := Cover {
                    art: root.playlist.cover;
                    placeholder: Icons.list-music;
                    detail: 48px;
                }

                // Over the cover, a click plays the playlist (or pauses it, if it's the one
                // playing); anywhere else opens it.
                if play-touch.has-hover: Rectangle {
                    border-radius: art.border-radius;
                    background: play-touch.pressed ? #000000c8 : #000000a0;
                    Icon {
                        source: root.playing ? Icons.pause-fill : Icons.play-fill;
                        size: 16px;
                        tint: white;
                    }
                }

                play-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: (root.playing ? "Pause " : "Play ") + root.playlist.name;
                    accessible-action-default => { root.play(); }
                    clicked => { root.play(); }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: root.playlist.name;
                color: root.selected ? Theme.accent-bright : Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: start;

                if root.playlist.pinned: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.pin;
                        size: 12px;
                        tint: Theme.accent-bright;
                    }
                }

                Text {
                    text: root.playlist.subtitle;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    // How tall the list below the name is, worked out from what's in it: the places to go,
    // the rule, the heading, then the playlists (or the line that stands in for them).
    property <length> tall: (10 + (App.requests ? 1 : 0)) * 42px + 19px + 38px + max(1, App.playlists.length) * 58px;
    background: Theme.panel;
    border-radius: Theme.radius;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        // The app's name: clicking it goes Home.
        Rectangle {
            height: 56px;
            accessible-role: button;
            accessible-label: "Nexus Music, go to Home";
            accessible-action-default => { App.navigate("home"); }

            brand := TouchArea {
                x: 4px;
                width: brand-row.preferred-width + 8px;
                mouse-cursor: pointer;
                clicked => { App.navigate("home"); }
            }

            brand-row := HorizontalLayout {
                x: 0;
                width: self.preferred-width;
                padding-left: 12px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 12px;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: brand.has-hover ? Theme.accent-bright : Theme.accent;
                    animate background { duration: 120ms; }
                    Icon {
                        source: Icons.bars;
                        size: 15px;
                        tint: white;
                    }
                }

                Text {
                    text: "Nexus Music";
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 19px;
                    font-weight: 700;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }

        // Everything below the name scrolls as one, so a short window still reaches all of
        // it: the places to go, then the playlists.
        Rectangle {
            vertical-stretch: 1;

            scroll := ScrollView {
                x: 0;
                width: parent.width + Lane.reach;
                height: parent.height;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    width: scroll.visible-width;
                    alignment: start;
                    spacing: 2px;
                    // Full width until there's enough to need the scrollbar.
                    padding-right: root.tall > scroll.height ? Lane.gutter : Lane.reach;

                    NavItem {
                        icon: Icons.house;
                        text: "Home";
                        selected: App.route == "home";
                        clicked => { App.navigate("home"); }
                    }

                    NavItem {
                        icon: Icons.disc-album;
                        text: "Albums";
                        selected: App.route == "albums";
                        clicked => { App.navigate("albums"); }
                    }

                    NavItem {
                        icon: Icons.users-round;
                        text: "Artists";
                        selected: App.route == "artists";
                        clicked => { App.navigate("artists"); }
                    }

                    NavItem {
                        icon: Icons.music;
                        text: "Songs";
                        selected: App.route == "songs";
                        clicked => { App.navigate("songs"); }
                    }

                    NavItem {
                        icon: Icons.tags;
                        text: "Genres";
                        selected: App.route == "genres";
                        clicked => { App.navigate("genres"); }
                    }

                    NavItem {
                        icon: Icons.heart;
                        text: "Liked songs";
                        selected: App.route == "liked";
                        clicked => { App.navigate("liked"); }
                    }

                    NavItem {
                        icon: Icons.radio;
                        text: "Radio";
                        selected: App.route == "radio";
                        clicked => { App.navigate("radio"); }
                    }

                    NavItem {
                        icon: Icons.chart-no-axes-column;
                        text: "Your stats";
                        selected: App.route == "stats";
                        clicked => { App.navigate("stats"); }
                    }

                    NavItem {
                        icon: Icons.download;
                        text: App.download-status == "" ? "Downloads" : App.download-status;
                        selected: App.route == "downloads";
                        clicked => { App.navigate("downloads"); }
                    }

                    if App.requests: NavItem {
                        icon: Icons.circle-arrow-down;
                        text: "Requests";
                        selected: App.route == "requests";
                        clicked => { App.navigate("requests"); }
                    }

                    // A jam joined from here has a page; otherwise this opens the window for starting
                    // or joining one, or for looking after the one hosted here.
                    NavItem {
                        icon: Icons.party-popper;
                        text: Jam.hosting ? (Jam.guests.length == 0 ? "Jam: waiting for guests" : Jam.guests.length == 1 ? "Jam: 1 guest" : "Jam: " + Jam.guests.length + " guests")
                            : Jam.joined ? Jam.host + "'s jam" : "Jam";
                        selected: App.route == "jam";
                        lit: Jam.hosting || Jam.joined;
                        clicked => {
                            if Jam.joined {
                                App.navigate("jam");
                            } else {
                                Jam.opened();
                                Jam.open = true;
                            }
                        }
                    }

                    Rectangle {
                        height: 17px;
                        Rectangle {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 1px;
                            background: Theme.line;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        height: 36px;

                        Text {
                            text: "Playlists";
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            add := IconButton {
                                icon: Icons.plus;
                                label: "Add a playlist";
                                clicked => { App.playlist-menu(add.absolute-position.x, add.absolute-position.y + add.height + 4px); }
                            }
                        }
                    }

                    if App.playlists.length == 0: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: "Playlists you create show up here.";
                            color: Theme.faint;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    for playlist in App.playlists: PlaylistItem {
                        playlist: playlist;
                        selected: App.route == "playlist:" + playlist.id;
                        clicked => {
                            View.card-activated({ kind: CardKind.playlist, id: playlist.id, title: playlist.name, cover: playlist.cover });
                        }
                        play => {
                            View.card-play({ kind: CardKind.playlist, id: playlist.id, title: playlist.name });
                        }
                        rested => {
                            View.card-hovered({ kind: CardKind.playlist, id: playlist.id });
                        }
                        menu(x, y) => {
                            View.card-menu({ kind: CardKind.playlist, id: playlist.id, title: playlist.name }, x, y);
                        }
                    }
                }
            }

            ScrollThumb {
                x: scroll.width - self.width;
                content-y <=> scroll.content-y;
                content-height: scroll.content-height;
                visible-height: scroll.visible-height;
            }
        }
    }
}

// A button for the window itself: minimise, maximise or close.
component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> closes;
    callback clicked;

    width: 48px;
    background: touch.pressed ? (self.closes ? #c42b1c.darker(0.2) : Theme.press)
        : touch.has-hover ? (self.closes ? #c42b1c : Theme.hover) : transparent;
    animate background { duration: 100ms; }

    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Icon {
        source: root.icon;
        size: 17px;
        tint: touch.has-hover ? (root.closes ? white : Theme.text) : Theme.muted;
    }
}

// The strip along the top of the window. It stands in for Windows' own title bar: empty parts
// of it drag the window, and it carries navigation, search and the window's buttons.
export component TopBar inherits Rectangle {
    property <int> focus-request: App.search-focus;
    changed focus-request => { search.focus(); }
    height: 60px;

    // Where the controls are, so the rest of the bar can be treated as the title bar.
    property <length> nav-right: App.signed-in ? 112px : 0px;
    property <length> buttons-width: App.custom-frame ? 3 * 48px : 0px;
    property <length> pill-width: App.signed-in && App.offline ? offline-label.preferred-width + 24px + 8px : 0px;
    property <length> controls-left: self.width - self.buttons-width - (App.signed-in ? 56px : 0px) - self.pill-width;
    out property <length> search-width: !App.signed-in ? 0px
        : clamp(self.width - 2 * max(self.nav-right, self.width - self.controls-left) - 48px, 160px, 520px);
    out property <length> search-x: (self.width - self.search-width) / 2;
    function report() {
        App.titlebar-layout(self.height, self.nav-right, self.search-x, self.search-x + self.search-width, self.controls-left);
    }
    init => { self.report(); }
    changed width => { self.report(); }
    changed nav-right => { self.report(); }
    changed controls-left => { self.report(); }
    changed search-width => { self.report(); }

    if App.signed-in: HorizontalLayout {
        x: 16px;
        width: 92px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            IconButton {
                width: 40px;
                height: 40px;
                icon: Icons.chevron-left;
                icon-size: 24px;
                enabled: App.can-go-back;
                label: "Go back";
                clicked => { App.go-back(); }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                width: 40px;
                height: 40px;
                icon: Icons.chevron-right;
                icon-size: 24px;
                enabled: App.can-go-forward;
                label: "Go forward";
                clicked => { App.go-forward(); }
            }
        }
    }

    Rectangle {
        visible: App.signed-in;
        x: root.search-x;
        y: (parent.height - self.height) / 2;
        width: root.search-width;
        height: 44px;
        border-radius: 22px;
        background: search.has-focus ? Theme.overlay : Theme.raised;
        border-width: 1px;
        border-color: search.has-focus ? Theme.accent-bright : transparent;
        animate border-color, background { duration: 120ms; }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.search;
                    size: 20px;
                    tint: search.has-focus ? Theme.text : Theme.muted;
                }
            }

            Rectangle {
                if search.text == "": Text {
                    x: 0;
                    width: parent.width;
                    text: "Search songs, albums, artists";
                    color: Theme.faint;
                    font-size: 15px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                search := TextInput {
                    width: parent.width;
                    height: parent.height;
                    text <=> App.search-text;
                    color: Theme.text;
                    font-size: 15px;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: white;
                    accessible-label: "Search";
                    edited => {
                        // Wait for a pause in typing before looking.
                        debounce.stop();
                        debounce.start();
                    }
                    // Enter opens the row picked out with the arrow keys, or else the full results.
                    accepted => {
                        debounce.stop();
                        if Search.open && Search.highlight >= 0 {
                            Search.activate(Search.highlight);
                        } else {
                            Search.open = false;
                            App.search(self.text);
                        }
                    }
                    key-pressed(event) => {
                        if Search.open && event.text == Key.DownArrow {
                            Search.highlight = min(Search.highlight + 1, Search.items.length - 1);
                            return accept;
                        }
                        if Search.open && event.text == Key.UpArrow {
                            Search.highlight = max(Search.highlight - 1, -1);
                            return accept;
                        }
                        if Search.open && event.text == Key.Escape {
                            Search.open = false;
                            return accept;
                        }
                        // With the suggestions closed, Down leaves the box for the results:
                        // the arrow keys then move through the songs found.
                        if !Search.open && event.text == Key.DownArrow && App.page == Page.search {
                            App.main-focus += 1;
                            View.move-selection(1, false);
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 32px;
                    height: 32px;
                    icon: Icons.x;
                    icon-size: 17px;
                    opacity: search.text == "" ? 0 : 1;
                    enabled: search.text != "";
                    label: "Clear search";
                    clicked => {
                        App.search-text = "";
                        Search.preview("");
                        App.search("");
                        search.focus();
                    }
                }
            }
        }
    }

    Rectangle {
        visible: App.signed-in && App.offline;
        x: root.controls-left;
        y: (parent.height - self.height) / 2;
        height: 28px;
        width: offline-label.preferred-width + 24px;
        border-radius: 14px;
        background: Theme.warm.with-alpha(0.16);
        offline-label := Text {
            text: App.offline-label;
            color: Theme.warm;
            font-size: 13px;
            font-weight: 600;
        }
    }

    if App.signed-in: cog := IconButton {
        x: root.width - root.buttons-width - 48px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        icon: Icons.settings;
        icon-size: 22px;
        active: App.route == "settings";
        label: App.route == "settings" ? "Close settings" : App.update-available ? "Settings (update available)" : "Settings";
        clicked => {
            if App.route == "settings" {
                App.go-back();
            } else {
                App.navigate("settings");
            }
        }

        if App.update-available: Rectangle {
            x: parent.width - 13px;
            y: 5px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.warm;
        }
    }

    if App.custom-frame: HorizontalLayout {
        x: root.width - root.buttons-width;
        width: root.buttons-width;

        WindowButton {
            icon: Icons.minus;
            label: "Minimise";
            clicked => { App.window-minimize(); }
        }

        WindowButton {
            icon: App.maximized ? Icons.copy : Icons.square;
            label: App.maximized ? "Restore" : "Maximise";
            clicked => { App.window-maximize(); }
        }

        WindowButton {
            icon: Icons.x;
            label: "Close";
            closes: true;
            clicked => { App.window-close(); }
        }
    }

    debounce := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.stop();
            Search.preview(search.text);
        }
    }
}

// One result in the preview under the search box.
component SuggestionRow inherits Rectangle {
    in property <Suggestion> item;
    in property <bool> highlighted;
    callback clicked;
    callback menu(x: length, y: length);

    height: 56px;
    border-radius: 8px;
    background: self.highlighted || touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: self.item.title + ", " + self.item.subtitle;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Cover {
                width: 40px;
                height: 40px;
                art: root.item.cover;
                round: root.item.kind == 0;
                placeholder: root.item.kind == 0 ? Icons.user-round : Icons.music;
                detail: 48px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;

            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }

            Text {
                text: root.item.subtitle;
                color: Theme.muted;
                font-size: 13px;
                overflow: elide;
            }
        }

        if root.item.liked: VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.heart-fill;
                size: 15px;
                tint: Theme.warm;
            }
        }
    }
}

// The preview of results under the search box. Fills the window so that a click anywhere
// else puts it away.
export component SearchOverlay inherits Rectangle {
    // Where the search box is.
    in property <length> anchor-x;
    in property <length> anchor-width;

    TouchArea {
        y: 60px;
        height: parent.height - 60px;
        clicked => { Search.open = false; }
    }

    Rectangle {
        property <length> wide: min(max(root.anchor-width, 460px), root.width - 16px);
        x: clamp(root.anchor-x + (root.anchor-width - self.wide) / 2, 8px, max(8px, root.width - self.wide - 8px));
        y: 56px;
        width: self.wide;
        height: rows.preferred-height;
        border-radius: 12px;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000090;

        // Clicks between the rows don't fall through to the page.
        TouchArea { }

        rows := VerticalLayout {
            padding: 6px;

            for item[index] in Search.items: SuggestionRow {
                item: item;
                highlighted: index == Search.highlight;
                clicked => { Search.activate(index); }
                menu(x, y) => { Search.menu(index, x, y); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 6px;
                Text {
                    text: "Enter for all results";
                    color: Theme.faint;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
        }
    }
}

// A song in the queue panel. Hovering turns its cover into a play button.
component QueueRow inherits Rectangle {
    in property <Track> track;
    // The row for the song that's playing: the button pauses and resumes instead.
    in property <bool> current;
    // Reordering by dragging: the row's place in its list, and the list's visible extent.
    in property <bool> can-reorder;
    in property <int> index;
    in property <int> count;
    in property <length> list-top;
    in property <length> list-bottom;
    // The keyboard is on this row.
    in property <bool> focused;
    callback play;
    callback menu(x: length, y: length);
    callback reordered(from: int, delta: int);
    callback nudge(by: length);

    height: 64px;
    border-radius: 6px;
    background: touch.has-hover || reorder.dragging || self.focused ? Theme.hover : transparent;
    border-width: self.focused ? 1px : 0px;
    border-color: Theme.accent;
    opacity: reorder.dragging ? 0.55 : root.track.unavailable ? 0.4 : 1;

    reorder := Reorder {
        enabled: root.can-reorder;
        index: root.index;
        count: root.count;
        list-top: root.list-top;
        list-bottom: root.list-bottom;
        moved(from, delta) => { root.reordered(from, delta); }
        nudge(by) => { root.nudge(by); }
    }

    accessible-role: list-item;
    accessible-label: self.track.title + ", " + self.track.artist;
    accessible-action-default => { root.play(); }

    touch := TouchArea {
        mouse-cursor: reorder.dragging ? grabbing : default;
        double-clicked => { root.play(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                reorder.press(self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                reorder.release();
            }
            if event.kind == PointerEventKind.cancel {
                reorder.cancel();
            }
        }
        moved => {
            if self.pressed {
                reorder.drag(self.mouse-x, self.mouse-y);
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;

                    art := Cover {
                        art: root.track.cover;
                        detail: 48px;
                    }

                    if touch.has-hover: Rectangle {
                        border-radius: art.border-radius;
                        background: play-touch.pressed ? #000000c8 : #000000a0;
                        accessible-role: button;
                        accessible-label: (root.current && Player.playing ? "Pause " : "Play ") + root.track.title;
                        accessible-action-default => { root.play(); }

                        play-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.play(); }
                        }

                        Icon {
                            source: root.current && Player.playing ? Icons.pause-fill : Icons.play-fill;
                            size: 18px;
                            tint: white;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                min-width: 60px;
                preferred-width: 0px;

                Text {
                    text: root.track.title;
                    color: root.current ? Theme.accent-bright : Theme.text;
                    font-size: 15px;
                    font-weight: 500;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    if root.track.downloaded: VerticalLayout {
                        alignment: center;
                        Icon {
                            source: Icons.circle-arrow-down;
                            size: 13px;
                            tint: Theme.accent-bright;
                        }
                    }

                    LinkText {
                        text: root.track.artist;
                        font-size: 13px;
                        enabled: root.track.artist-id != "";
                        clicked => {
                            View.card-activated({ kind: CardKind.artist, id: root.track.artist-id, title: root.track.artist });
                        }
                    }

                    // In a jam: which guest added it.
                    if root.track.by != "": Text {
                        text: "• " + root.track.by;
                        color: Theme.accent-bright;
                        font-size: 13px;
                        overflow: elide;
                        accessible-label: "Added by " + root.track.by;
                    }
                }
            }

            // The length gives way to the menu button while the pointer is on the row.
            Rectangle {
                width: 36px;

                if !touch.has-hover: Text {
                    width: parent.width;
                    text: root.track.duration;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                if touch.has-hover: more := IconButton {
                    x: parent.width - self.width;
                    icon: Icons.ellipsis;
                    label: "More options for " + root.track.title;
                    clicked => {
                        root.menu(more.absolute-position.x, more.absolute-position.y + more.height);
                    }
                }
            }
        }
    }
}

component PanelTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    width: label.preferred-width;
    accessible-role: tab;
    accessible-label: self.text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        color: root.selected || touch.has-hover ? Theme.text : Theme.muted;
        font-family: Theme.display;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }

    if root.selected: Rectangle {
        y: parent.height - 9px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-bright;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueuePanel inherits Rectangle {
    // Songs being dragged are over the panel: letting go adds them to the queue.
    property <bool> drop-here: Drag.active
        && Drag.x >= self.absolute-position.x && Drag.x < self.absolute-position.x + self.width
        && Drag.y >= self.absolute-position.y && Drag.y < self.absolute-position.y + self.height;
    changed drop-here => {
        if self.drop-here {
            Drag.target = "queue";
        } else if Drag.target == "queue" {
            Drag.target = "";
        }
    }

    // The window is too narrow for the panel to sit beside the page: it lies over it.
    in property <bool> over;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: self.drop-here ? 2px : self.over ? 1px : 0px;
    border-color: self.drop-here ? Theme.accent-bright : Theme.line;
    drop-shadow-blur: self.over ? 28px : 0px;
    drop-shadow-color: self.over ? #000000a0 : transparent;

    // Nothing clicked here reaches the page underneath.
    TouchArea { }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: Lane.gutter - Lane.reach;
            spacing: 20px;
            height: 48px;

            PanelTab {
                text: "Queue";
                selected: App.queue-tab == 0;
                clicked => { App.queue-tab = 0; }
            }

            PanelTab {
                text: "Recently played";
                selected: App.queue-tab == 1;
                clicked => { App.queue-tab = 1; }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    label: "Close";
                    clicked => {
                        if root.over {
                            App.queue-over = false;
                        } else {
                            App.set-queue-open(false);
                        }
                    }
                }
            }
        }

        if App.queue-tab == 0 && !Player.has-track: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: "Nothing is playing. Pick an album or playlist to start a queue.";
                color: Theme.faint;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // Another device has been playing since this one did anything: offer to pick it up.
        if App.queue-tab == 0 && Player.elsewhere != "": Rectangle {
            height: 58px;
            Rectangle {
                x: 4px;
                width: parent.width - Lane.gutter + Lane.reach - 8px;
                height: 50px;
                border-radius: 8px;
                background: Theme.raised;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Playing on another device";
                            color: Theme.muted;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Text {
                            text: Player.elsewhere;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Continue here";
                            clicked => { Player.continue-here(); }
                        }
                    }
                }
            }
        }

        if App.queue-tab == 0 && Player.has-track: HorizontalLayout {
            padding-left: 12px;
            height: 28px;
            Text {
                text: "Now playing";
                color: Theme.muted;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if App.queue-tab == 0 && Player.has-track: Rectangle {
            height: 64px;
            QueueRow {
                x: 0;
                width: parent.width - Lane.gutter + Lane.reach;
                track: Player.track;
                current: true;
                play => { Player.toggle(); }
                menu(x, y) => { Player.queue-menu(-1, x, y); }
            }
        }

        if App.queue-tab == 0 && Player.has-track: HorizontalLayout {
            padding-left: 12px;
            padding-right: Lane.gutter - Lane.reach + 8px;
            spacing: 14px;
            height: 36px;

            // With songs queued by hand, they come first, under their own heading; the
            // heading for the rest of the list is then a row further down.
            Text {
                horizontal-stretch: 1;
                text: Player.queue.length == 0 ? "Nothing queued after this"
                    : Player.queued > 0 ? "Next in queue"
                    : Player.context == "" ? "Next up" : "Next from " + Player.context;
                color: Theme.muted;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            if Player.queue.length > 0 && Player.queued == 0 && !Jam.joined: VerticalLayout {
                alignment: center;
                LinkText {
                    text: "Save";
                    clicked => { Player.save-queue(); }
                }
            }

            if Player.queue.length > 0: VerticalLayout {
                alignment: center;
                LinkText {
                    text: Player.queued > 0 ? "Clear queue" : "Clear";
                    clicked => { Player.clear-queue(Player.queued > 0); }
                }
            }
        }

        if App.queue-tab == 0: Rectangle {
            vertical-stretch: 1;
            upcoming := ListView {
                // Keep the row the keyboard is on in view.
                property <int> cursor: App.keys-in-queue ? Player.queue-cursor : -1;
                changed cursor => {
                    if self.cursor >= 0 {
                        if -self.content-y > self.cursor * 64px {
                            self.content-y = -self.cursor * 64px;
                        } else if -self.content-y + self.visible-height < (self.cursor + 1) * 64px {
                            self.content-y = self.visible-height - (self.cursor + 1) * 64px;
                        }
                    }
                }
                x: 0;
                width: parent.width + Lane.reach;
                height: parent.height;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                for track[index] in Player.queue: Rectangle {
                    height: 64px;

                    // The heading between the songs queued by hand and the rest of the list.
                    if index == Player.queue-gap: HorizontalLayout {
                        x: 12px;
                        y: parent.height - self.height;
                        width: parent.width - Lane.gutter - 12px - 8px;
                        height: 36px;
                        spacing: 14px;

                        Text {
                            horizontal-stretch: 1;
                            text: Player.context == "" ? "Next up" : "Next from " + Player.context;
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if !Jam.joined: VerticalLayout {
                            alignment: center;
                            LinkText {
                                text: "Save";
                                clicked => { Player.save-queue(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            LinkText {
                                text: "Clear";
                                clicked => { Player.clear-queue(false); }
                            }
                        }
                    }

                    if index != Player.queue-gap: QueueRow {
                        x: 0;
                        width: parent.width - Lane.gutter;
                        track: track;
                        can-reorder: true;
                        index: index;
                        count: Player.queue.length;
                        focused: App.keys-in-queue && index == Player.queue-cursor;
                        list-top: upcoming.absolute-position.y;
                        list-bottom: upcoming.absolute-position.y + upcoming.height;
                        play => { Player.queue-activated(index); }
                        menu(x, y) => { Player.queue-menu(index, x, y); }
                        reordered(from, delta) => { Player.queue-moved(from, delta); }
                        nudge(by) => {
                            upcoming.content-y = clamp(upcoming.content-y + by, min(0px, upcoming.visible-height - upcoming.content-height), 0px);
                        }
                    }
                }
            }

            ScrollThumb {
                x: upcoming.width - self.width;
                content-y <=> upcoming.content-y;
                content-height: upcoming.content-height;
                visible-height: upcoming.visible-height;
            }
        }

        if App.queue-tab == 1 && Player.history.length == 0: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: "Songs you play show up here, newest first.";
                color: Theme.faint;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        if App.queue-tab == 1: Rectangle {
            vertical-stretch: 1;
            played := ListView {
                x: 0;
                width: parent.width + Lane.reach;
                height: parent.height;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                for track[index] in Player.history: Rectangle {
                    height: 64px;
                    QueueRow {
                        x: 0;
                        width: parent.width - Lane.gutter;
                        track: track;
                        play => { Player.history-activated(index); }
                        menu(x, y) => { Player.history-menu(index, x, y); }
                    }
                }
            }

            ScrollThumb {
                x: played.width - self.width;
                content-y <=> played.content-y;
                content-height: played.content-height;
                visible-height: played.visible-height;
            }
        }
    }
}

// The devices, in the side panel where the queue otherwise is: where the music is playing,
// a way into a jam, and the person's other devices to move it to.
export component ConnectPanel inherits Rectangle {
    // The window is too narrow for the panel to sit beside the page: it lies over it.
    in property <bool> over;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: self.over ? 1px : 0px;
    border-color: Theme.line;
    drop-shadow-blur: self.over ? 28px : 0px;
    drop-shadow-color: self.over ? #000000a0 : transparent;
    // (With the new linking's list above the old one, the two together can be taller than
    // a small window's panel: what does not fit is cut off at its foot, not drawn over the
    // player. Only where the new linking is switched on: without it nothing changes here.)
    clip: Linked.on;

    // Nothing clicked here reaches the page underneath.
    TouchArea { }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: Lane.gutter - Lane.reach;
            height: 48px;

            Text {
                text: "Connect";
                color: Theme.text;
                font-family: Theme.display;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    label: "Close";
                    clicked => { Devices.open = false; }
                }
            }
        }

        // Where the music is, and listening with friends.
        Rectangle {
            border-radius: 8px;
            background: Theme.raised;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: Icons.monitor-speaker;
                            size: 22px;
                            tint: Theme.accent-bright;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;

                        Text {
                            text: Jam.linked ? Jam.device : Devices.list.length > 0 ? Devices.list[0].name : "This PC";
                            color: Theme.accent-bright;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: Jam.linked ? "Playing there" : "This PC";
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    if Jam.linked: VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 32px;
                            text: "Play here";
                            clicked => { Devices.choose(""); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: Jam.hosting ? (Jam.guests.length == 0 ? "Hosting a jam. Waiting for guests." : Jam.guests.length == 1 ? "Hosting a jam with 1 guest" : "Hosting a jam with " + Jam.guests.length + " guests")
                            : Jam.joined ? "In " + Jam.host + "'s jam"
                            : "Listen with friends anywhere";
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 32px;
                            text: Jam.hosting ? "Manage" : Jam.joined ? "Leave" : Jam.can-host ? "Start a jam" : "Join a jam";
                            clicked => {
                                if Jam.joined {
                                    Jam.leave();
                                } else {
                                    Jam.opened();
                                    Jam.open = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // The new linking, shown only where it is switched on for a test (see src/link.rs):
        // the person's other devices as it knows them. One that is here can be picked, to
        // steer it and move what's playing over to it; one seen before that isn't here
        // just now is listed all the same, and can't be.
        if Linked.on: Text {
            height: 28px;
            text: "   Linked devices (new)";
            color: Theme.muted;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // Every device but the one being steered, which is named at the top.
        for device in Linked.list: Rectangle {
            height: device.active ? 0px : 56px;
            clip: true;
            if !device.active: HorizontalLayout {
                padding-right: 28px;
                spacing: 8px;
                DeviceRow {
                    horizontal-stretch: 1;
                    device: { id: device.place, name: device.name, about: device.about, active: false, ready: device.ready };
                    chosen => { Linked.choose(device.place); }
                }
                // (A small button: in a narrow window the name beside it keeps its room.)
                if device.ready && device.playing: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.pause-fill;
                        label: "Pause " + device.name;
                        clicked => { Linked.pause(device.place); }
                    }
                }
            }
        }

        if Linked.on && Linked.list.length == 0: Text {
            text: Linked.entered ? "No other device is linked yet." : "Not linked yet.";
            color: Theme.muted;
            font-size: 13px;
            x: 12px;
            width: parent.width - 40px;
        }

        if Linked.on && Linked.note != "": Text {
            text: Linked.note;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            x: 12px;
            width: parent.width - 40px;
        }

        if Devices.list.length > 1: Text {
            height: 28px;
            text: "   Your devices";
            color: Theme.muted;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // Every device but the one named above.
        for device in Devices.list: Rectangle {
            height: device.active || Devices.list.length < 2 ? 0px : 56px;
            clip: true;
            if !device.active: DeviceRow {
                device: device;
                chosen => { Devices.choose(device.id); }
            }
        }

        if Devices.list.length < 2: Text {
            text: Devices.linked ? "Your other devices show up here when Nexus Music is open on them, signed in to the same account, with the same relay set up under Settings, Jam."
                : "To play on your other devices from here, set up a relay on each of them under Settings, Jam, and leave “Link my devices” on.";
            color: Theme.muted;
            font-size: 13px;
            wrap: word-wrap;
            x: 12px;
            width: parent.width - 40px;
        }
    }
}

// Something to press on the jam strip.
component StripLink inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: label.preferred-width + 24px;
    height: 24px;
    border-radius: 12px;
    background: touch.pressed ? #00000050 : touch.has-hover ? #00000038 : #00000024;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }
}

// The strip along the bottom of the window while this PC is in a jam: it says whose, where
// the music is playing, and how to get out.
export component JamStrip inherits Rectangle {
    background: Theme.accent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.party-popper;
                size: 16px;
                tint: white;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: Jam.linked ? "Playing on " + Jam.device + ". This player and queue control it."
                : Jam.joined ? "In " + Jam.host + "'s jam. The music plays where " + Jam.host + " is; this player and queue control it."
                : Jam.guests.length == 0 ? "Hosting a jam. The music plays here; waiting for guests to join."
                : Jam.guests.length == 1 ? "Hosting a jam with " + Jam.guests[0].name + ". The music plays here."
                : "Hosting a jam with " + Jam.guests.length + " guests. The music plays here.";
            color: white;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        if Jam.linked: VerticalLayout {
            alignment: center;
            StripLink {
                text: "Play here";
                clicked => { Devices.choose(""); }
            }
        }

        if Jam.linked: VerticalLayout {
            alignment: center;
            StripLink {
                text: "Stop steering";
                clicked => { Jam.leave(); }
            }
        }

        if Jam.joined: VerticalLayout {
            alignment: center;
            StripLink {
                text: "Find songs";
                clicked => { App.navigate("jam"); }
            }
        }

        if Jam.joined: VerticalLayout {
            alignment: center;
            StripLink {
                text: "Leave jam";
                clicked => { Jam.leave(); }
            }
        }

        if Jam.hosting && !Jam.linked: VerticalLayout {
            alignment: center;
            StripLink {
                text: "Invite and manage";
                clicked => {
                    Jam.opened();
                    Jam.open = true;
                }
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    // The window has room for the queue beside the page; otherwise it opens over the page.
    in property <bool> wide: true;
    property <bool> queue-open: self.wide ? App.queue-open : App.queue-over;
    height: 84px;

    property <length> side: max(220px, self.width * 0.28);
    property <float> progress: Player.duration > 0 ? Player.position / Player.duration : 0;

    // What's playing.
    Rectangle {
        x: 8px;
        width: root.side;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            if Player.has-track: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    now-art := Cover {
                        art: Player.track.cover;
                        detail: 64px;
                    }

                    // The artwork opens (and closes) the Now Playing screen.
                    if expand.has-hover: Rectangle {
                        border-radius: now-art.border-radius;
                        background: #000000a0;
                        Icon {
                            source: App.page == Page.now-playing ? Icons.minimize-2 : Icons.maximize-2;
                            size: 20px;
                            tint: white;
                        }
                    }

                    expand := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: App.page == Page.now-playing ? "Close Now Playing" : "Open Now Playing";
                        accessible-action-default => { self.clicked(); }
                        clicked => {
                            if App.page == Page.now-playing {
                                App.go-back();
                            } else {
                                App.navigate("now-playing");
                            }
                        }
                    }
                }
            }

            if Player.has-track: VerticalLayout {
                alignment: center;
                spacing: 3px;
                width: min(max(now-title.preferred-width, now-artist.preferred-width, now-format.preferred-width), max(60px, root.side - 56px - 14px - 14px - 32px - 8px));

                now-title := LinkText {
                    text: Player.track.title;
                    ink: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    enabled: Player.track.album-id != "";
                    clicked => {
                        View.card-activated({
                            kind: CardKind.album,
                            id: Player.track.album-id,
                            title: Player.track.album,
                            subtitle: Player.track.artist,
                            cover: Player.track.cover,
                        });
                    }
                }

                now-artist := LinkText {
                    text: Player.track.artist;
                    font-size: 12px;
                    enabled: Player.track.artist-id != "";
                    clicked => {
                        View.card-activated({ kind: CardKind.artist, id: Player.track.artist-id, title: Player.track.artist });
                    }
                }

                now-format := Text {
                    property <string> waiting: Player.reconnecting ? "Reconnecting…" : Player.stalled ? "Buffering…" : "";
                    text: self.waiting != "" ? self.waiting : Player.format;
                    color: self.waiting != "" ? Theme.muted : Player.lossless ? Theme.accent-bright : Theme.faint;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                    accessible-label: self.waiting != "" ? self.waiting : "Audio format: " + Player.format;
                }
            }

            if Player.has-track: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Player.track.starred ? Icons.heart-fill : Icons.heart;
                    icon-size: 17px;
                    tint: Player.track.starred ? Theme.warm : Theme.muted;
                    hover-tint: Player.track.starred ? Theme.warm : Theme.text;
                    label: Player.track.starred ? "Remove from Liked songs" : "Add to Liked songs";
                    clicked => { Player.toggle-star(); }
                }
            }
        }

    }

    // Transport.
    Rectangle {
        x: 8px + root.side;
        width: root.width - 2 * root.side - 20px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.shuffle;
                        icon-size: 17px;
                        active: Player.shuffle;
                        label: Player.shuffle ? "Turn off shuffle" : "Shuffle";
                        clicked => { Player.toggle-shuffle(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.prev-fill;
                        icon-size: 17px;
                        tint: Theme.text;
                        enabled: Player.has-track;
                        label: "Previous";
                        clicked => { Player.previous(); }
                    }
                }

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 19px;
                    background: toggle.pressed ? Theme.muted : Theme.text;
                    opacity: Player.has-track ? 1 : 0.4;
                    accessible-role: button;
                    accessible-label: Player.playing ? "Pause" : "Play";
                    accessible-action-default => { Player.toggle(); }

                    toggle := TouchArea {
                        enabled: Player.has-track;
                        mouse-cursor: pointer;
                        clicked => { Player.toggle(); }
                    }

                    Icon {
                        source: Player.playing ? Icons.pause-fill : Icons.play-fill;
                        size: 16px;
                        tint: Theme.base;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.next-fill;
                        icon-size: 17px;
                        tint: Theme.text;
                        enabled: Player.has-track;
                        label: "Next";
                        clicked => { Player.next(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Player.repeat == 2 ? Icons.repeat-1 : Icons.repeat;
                        icon-size: 17px;
                        active: Player.repeat != 0;
                        label: Player.repeat == 0 ? "Repeat" : Player.repeat == 1 ? "Repeat one" : "Turn off repeat";
                        clicked => { Player.cycle-repeat(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    width: 44px;
                    text: Player.has-track ? Player.clock(seek.dragging ? seek.drag-value * Player.duration : Player.position) : "";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                seek := Slider {
                    width: clamp(root.width - 2 * root.side - 140px, 120px, 640px);
                    value: root.progress;
                    enabled: Player.has-track && Player.duration > 0;
                    label: "Seek";
                    released(value) => { Player.seek(value * Player.duration); }
                }

                Text {
                    width: 44px;
                    // A radio station has no length.
                    text: !Player.has-track ? "" : Player.duration > 0 ? Player.clock(Player.duration) : "Live";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

    }

    // Lyrics, queue and volume.
    Rectangle {
        x: root.width - root.side - 12px;
        width: root.side;

        HorizontalLayout {
            alignment: end;
            spacing: 2px;

            VerticalLayout {
                alignment: center;
                sleep := IconButton {
                    icon: Icons.moon;
                    icon-size: 17px;
                    active: Player.sleep != "";
                    label: Player.sleep != "" ? Player.sleep : "Sleep timer";
                    clicked => { Player.choose-sleep(sleep.absolute-position.x - 60px, sleep.absolute-position.y - 8px); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.mic-vocal;
                    icon-size: 17px;
                    active: App.page == Page.lyrics;
                    enabled: Player.has-track;
                    label: "Lyrics";
                    clicked => {
                        if App.page == Page.lyrics {
                            App.go-back();
                        } else {
                            App.navigate("lyrics");
                        }
                    }
                }
            }

            if root.side >= 264px: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.picture-in-picture-2;
                    icon-size: 17px;
                    enabled: Player.has-track;
                    label: "Mini player";
                    clicked => { Player.open-mini(); }
                }
            }

            // Shows the devices in the side panel, in the queue's place.
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.monitor-speaker;
                    icon-size: 17px;
                    active: Jam.linked || Devices.open;
                    label: Jam.linked ? "Playing on " + Jam.device : "Connect to a device";
                    clicked => { Devices.open = !Devices.open; }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.list-music;
                    icon-size: 17px;
                    active: root.queue-open && !Devices.open;
                    label: "Queue";
                    clicked => {
                        // With the devices in the panel, this brings the queue back to it.
                        if Devices.open {
                            Devices.open = false;
                            if !root.wide {
                                App.queue-over = true;
                            } else if !App.queue-open {
                                App.set-queue-open(true);
                            }
                        } else if !root.wide {
                            App.queue-over = !App.queue-over;
                        } else {
                            App.set-queue-open(!App.queue-open);
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Player.muted || Player.volume == 0 ? Icons.volume-x : Player.volume < 0.5 ? Icons.volume-1 : Icons.volume-2;
                    icon-size: 17px;
                    label: Player.muted ? "Unmute" : "Mute";
                    clicked => { Player.toggle-mute(); }
                }
            }

            VerticalLayout {
                alignment: center;
                Slider {
                    width: clamp(root.side - 218px, 60px, 110px);
                    value: Player.muted ? 0 : Player.volume;
                    label: "Volume";
                    moved(value) => { Player.set-volume(value); }
                    scrolled(delta) => {
                        Player.set-volume(clamp(Player.volume + (delta > 0 ? 0.05 : -0.05), 0, 1));
                    }
                }
            }
        }
    }
}
